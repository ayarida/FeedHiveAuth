    .back-btn {
        width: fit-content;
        white-space: nowrap;
        overflow: hidden;
        border: 1px solid #c2b1b1;
    }

        .back-btn:hover {
            animation: width ease-in-out 0.1s;
        }


            .back-btn:hover::before {
                white-space: nowrap;
                overflow: hidden;
                animation: width 0.1s linear forwards;
            }


    .back-container {
        white-space: nowrap;
        overflow: hidden;
        animation: width 0.1s linear forwards;
    }


    input, textarea {
        width: 510px !important;
        max-width: 100%;
