    @foreach (var post in posts.Take(5))
    {
        <p>@post.Title</p>
    }
</div> *@


<div class="d-flex flex-wrap create">

    <div class="" style="width: fit-content">
        <div class="card  p-3">
            <h1>أنشئ المحتوى</h1>

            <br />
            @*  <h4>Post</h4> *@
            <H4>@User.Identity?.Name </H4>
            <hr />
            <div class="row">
                <div class="create-post">
                    <div class="card-head my-2">

                        <form asp-controller="Posts" asp-action="CreatePost" enctype="multipart/form-data" method="post" style="max-width: 100%;width: 100%;" id="create-form" dir="rtl">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                            <div class="form-group mb-4">
                                <label asp-for="Title" class="control-label">عنوان</label>
                                <input asp-for="Title" class="form-control req" />
                                <span asp-validation-for="Title" class="text-danger"></span>
                            </div>
                            <div class="form-group mb-4">
                                <label asp-for="ShortTitle" class="control-label ">عنوان قصير</label>
                                <input asp-for="ShortTitle" class="form-control" />
                                <span asp-validation-for="ShortTitle" class="text-danger"></span>
                            </div>
                            <div class="form-group mb-4">
                                <label asp-for="Summary" class="control-label">ملخص</label>
                                <input asp-for="Summary" class="form-control" />
                                <span asp-validation-for="Summary" class="text-danger"></span>
                            </div>
                            <div class="form-group mb-4">
                                <label asp-for="Content" class="control-label">محتوى</label>
                                <textarea asp-for="Content" class="form-control"></textarea>
                                <span asp-validation-for="Content" class="text-danger"></span>
                            </div>
                            <div class="form-group mb-4">
                                <label asp-for="PostDate" class="control-label">تاريخ النشر</label>
                                <input asp-for="PostDate" class="form-control req" />
                                <span asp-validation-for="PostDate" class="text-danger"></span>
                            </div>
                            @* PreviewIamge and handle exceptions *@
                            <partial name="_imagePreview" />
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>





<style>
    .uploaded-img {
        position: relative;
    }

    .deleteIcon {
        width: fit-content;
        position: absolute;
        left: 0;
        right: auto;
        top: 0;
        padding: 3px 10px;
        background: rgb(10 44 63 / 60%);
        border-radius: 3px;
    }

        .deleteIcon i.bi.bi-trash3-fill {
            cursor: pointer;
            color: white;
            opacity: 0.6;
        }

            .deleteIcon i.bi.bi-trash3-fill:hover {
                opacity: 1;
            }

    .card-head {
        justify-content: start;
    }

    .video-holder{
        position: relative;
    }

    form video {
        width: 300px;
    }

    form img {
        width: 300px;
    }

    .control-label {
        margin-bottom: 10px;
    }

    .custom-file-upload {
        width: 22%;
    }


    @@media(max-width: 500px) {
        .custom-file-upload {
            width: 100%;
        }
    }

    input {
        border-radius: 5px !important;
    }

    .star:after {
        content: " *";
        color: red;
    }


    /*Back button */
    .back-btn:hover i {
        display: none;
    }

    .back-container {
        width: 67px;
    }

    .back-btn:hover:before {
        content: "Back to post list";
    }

    .back-btn {
        width: fit-content;
        white-space: nowrap;
        overflow: hidden;
        border: 1px solid #c2b1b1;
    }

        .back-btn:hover {
            animation: width ease-in-out 0.1s;
        }


            .back-btn:hover::before {
                white-space: nowrap;
                overflow: hidden;
                animation: width 0.1s linear forwards;
            }


    .back-container {
        white-space: nowrap;
        overflow: hidden;
        animation: width 0.1s linear forwards;
    }


    input, textarea {
        width: 510px !important;
        max-width: 100%;
        border-color: #212c37 !important;
        text-align: right;
    }


    @@keyframes width {
        from {
            width: 67px;
        }

        to {
            width: 164px;
        }
    }

    main.pb-3 * {
        max-width: 100%;
    }

    .create {
        column-gap: 20px;
        row-gap: 20px;
    }

    th {
        margim-bottom: 10px;
        padding: 0 15px;
    }

    td {
        padding: 18px 15px;
    }

    td {
        border-bottom: 1px solid #dddddd;
    }

    @@media (max-width: 1400px) {
        .create {
            align-content: center;
            justify-content: center;
        }
    }
</style>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

