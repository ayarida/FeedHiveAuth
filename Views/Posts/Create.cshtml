@model FeedHiveAuth.Models.Post
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
    // var posts = Model.Title. ;

}

<div>
</div>




<div class="card p-4" style="width: fit-content">
    <h1>أنشئ المحتوى</h1>

    <br />
    @*  <h4>Post</h4> *@
    <H4>@User.Identity?.Name </H4>
    @*             @if (User.IsInRole("Admin"))
    {
    <p>this is an Admin User</p>
    }
    else
    {
    <p dir="auto" style="text-align: match-parent;">this is a normal role and user @User.Identity. </p>
    } *@
    <hr />
    <div class="row">
        <div class="create-post">
            <div class="card-head my-2">

                <form asp-controller="Posts" asp-action="CreatePost" enctype="multipart/form-data" method="post" style="max-width: 100%;width: 100%;" id="create-form" dir="rtl">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="form-group mb-4">
                        <label asp-for="Title" class="control-label">عنوان</label>
                        <input asp-for="Title" class="form-control req" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-4">
                        <label asp-for="ShortTitle" class="control-label ">عنوان قصير</label>
                        <input asp-for="ShortTitle" class="form-control" />
                        <span asp-validation-for="ShortTitle" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-4">
                        <label asp-for="Summary" class="control-label">ملخص</label>
                        <input asp-for="Summary" class="form-control" />
                        <span asp-validation-for="Summary" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-4">
                        <label asp-for="Content" class="control-label">محتوى</label>
                        <textarea asp-for="Content" class="form-control"></textarea>
                        <span asp-validation-for="Content" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-4">
                        <label asp-for="PostDate" class="control-label">تاريخ النشر</label>
                        <input asp-for="PostDate" class="form-control req" />
                        <span asp-validation-for="PostDate" class="text-danger"></span>
                    </div>
                    <div style="display: flex;align-items: center;column-gap: 20px; flex-direction: column" class="my-5">
                        <div class="mb-3">صورة / فيديو</div>
                        <label class="custom-file-upload mb-3" style="border-radius: 10px;border-color: var(--blue-color);box-shadow: 0px 3px 6px #00000029;background: white;">
                            تحميل
                            <i class="bi bi-cloud-arrow-up-fill" style="font-size: 25px;color: var(--blue-color);margin-right: 5px;"></i>
                            <input type="file" name="File" id="mediaInput" />
                        </label>
                        <img id="imgPreview" src="" style="width: 400px; max-width: 100%" />
                        <video style="width: 400px; max-width: 100%" controls class="video">
                            <source src="" type="video/mp4" id="videoPreview">
                        </video>
                    </div>

                    <div class="form-group mb-4 d-flex justify-content-center">
                        <input type="submit" value="أنشئ المحتوى" class="btn btn-primary submit-button" style="max-width: 50%;width: 100%; border-radius: 28px;" />
                    </div>


                </form>


            </div>
        </div>
    </div>
</div>



<div id="snackbar" style="background-color:var(--delete-color);border-radius:10px" dir="auto">Please fill the missing fields !</div>




<script>




    // check media type and preview it


    mediaInput.onchange = evt => {
        const [file] = mediaInput.files
        const fileType = file['type']
        const videoType = ['mp4']
        const validImageTypes = ['image/webp', 'image/jpeg', 'image/png'];

        if (file) {

            if (fileType.includes(videoType)) {

                videoPreview.src = URL.createObjectURL(file)
                $("#videoPreview").parent()[0].load();
                $(".video").show();
            }

            else {
                imgPreview.src = URL.createObjectURL(file)
                $("#imgPreview").show();

            }
        }
    }


    //check for missing fields

    $(".create-post").ready(function () {

        $(".submit-button").on("click", function () {

            $("input.form-control.req").each(function (index, element) {
                if ($(element).val() === 0 || $(element).val() === '') {
                    $(this).prev().addClass("star");
                    var x = document.getElementById("snackbar");
                    x.className = "show";
                    setTimeout(function () { x.className = x.className.replace("show", ""); }, 3000);
                    event.preventDefault();
                }

            })

        })
    });


</script>


<style>
    .card-head {
        justify-content: start;
    }

    video {
        display: none;
    }

    #imgPreview {
        display: none;
    }

    .control-label {
        margin-bottom: 10px;
    }

    .custom-file-upload {
        width: 20%;
    }

    @@media(max-width: 500px) {
        .custom-file-upload {
            width: 100%;
        }
    }

    input {
        border-radius: 5px !important;
    }

    .star:after {
        content: " *";
        color: red;
    }

    /*Toast animation*/
    #snackbar {
        visibility: hidden;
        min-width: 250px;
        margin-left: -125px;
        background-color: #333;
        color: #fff;
        text-align: center;
        border-radius: 2px;
        padding: 16px;
        position: fixed;
        z-index: 1;
        left: 50%;
        top: 100px;
        font-size: 17px;
        height: fit-content !important;
    }

        #snackbar.show {
            visibility: visible;
            -webkit-animation: fadein 0.5s, fadeout 0.5s 2.5s;
            animation: fadein 0.5s, fadeout 0.5s 2.5s;
        }

    @@-webkit-keyframes fadein {
        from {
            top: 0;
            opacity: 0;
        }

        to {
            top: 30px;
            opacity: 1;
        }
    }

    @@keyframes fadein {
        from {
            top: 0;
            top: 0;
        }

        re
        to {
            bottom: 30px;
            opacity: 1;
        }
    }

    @@-webkit-keyframes fadeout {
        from {
            top: 30px;
            opacity: 1;
        }

        to {
            top: 0;
            opacity: 0;
        }
    }

    @@keyframes fadeout {
        from {
            top: 30px;
            opacity: 1;
        }

        to {
            top: 0;
            opacity: 0;
        }
    }
    /*Back button */
    .back-btn:hover i {
        display: none;
    }

    .back-container {
        width: 67px;
    }

    .back-btn:hover:before {
        content: "Back to post list";
    }

    .back-btn {
        width: fit-content;
        white-space: nowrap;
        overflow: hidden;
        border: 1px solid #c2b1b1;
    }

        .back-btn:hover {
            animation: width ease-in-out 0.1s;
        }


            .back-btn:hover::before {
                white-space: nowrap;
                overflow: hidden;
                animation: width 0.1s linear forwards;
            }


    .back-container {
        white-space: nowrap;
        overflow: hidden;
        animation: width 0.1s linear forwards;
    }


    input, textarea {
        width: 510px !important;
        max-width: 100%;
        border-color: #212c37 !important;
        text-align: right;
    }


    @@keyframes width {
        from {
            width: 67px;
        }

        to {
            width: 164px;
        }
    }
</style>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
