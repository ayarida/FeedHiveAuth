@using FeedHiveAuth.Areas.Social.Models;
@using Microsoft.AspNetCore.Identity;
@using FeedHiveAuth.Models.Enums;
@using FeedHiveAuth.Data.Helpers


@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@model FeedHiveAuth.Models.Post

@{
    var post = Model;
    var operation = post.Operations.OrderBy(o => o.CreationDate).Reverse();
    Layout = "~/Views/Shared/_Layout.cshtml";

}


<div class="editor ms-auto pe-3 card" dir="rtl" style="max-width: 100%; background-color: white;">
    <div class="pt-4 mt-4">
        <div class="form-items">
            <div class="row mx-4 gx-5 p-3">
                <h2>استعراض المنشور</h2>
            </div>

            <form id="form-share" method="post" action="send" class="p-4">

                <div class="row m-4 gx-5 p-3 preview-box">
                    <div class="input-fields col-md-6 d-flex justify-content-between w-100">

                        <div style="width: 400px">
                            <div class="form-group mb-4">
                                <label class="mb-3 control-label">عنوان المنشور</label>
                                <br />
                                <input class="form-control" value="@post.Title" name="Data[0].Text" readonly type="text" id="post-title" />
                            </div>

                            <div class="form-group mb-4">
                                <label class="mb-3 control-label">عنوان قصير</label>
                                <br />
                                <input value="@post.ShortTitle" name="ShortTitle" readonly type="text" class="form-control" />
                            </div>

                            <div class="form-group mb-4">
                                <label class="mb-3 control-label">ملخص</label>
                                <br />
                                <input value="@post.Summary" name="Summary" readonly class="form-control" />
                            </div>

                            <div class="form-group mb-4">
                                <label class="mb-3 control-label">محتوى</label>
                                <br />
                                <input value="@post.Content" name="Content" readonly class="form-control" id="post-description" />
                            </div>

                            <input class="form-control req" type="datetime-local" id="ScheduleTime" name="Data[0].ScheduleTime" value="">
                        </div>

                        <div class="form-group mb-4 mt-3 d-flex flex-column">
                            @if (post.PostMediaItems != null && post.PostMediaItems.Count > 0)
                            {
                                <label for="MediaId" class="mb-3 control-label">ميديا </label>
                                <br />
                                <img src="@post.PostMediaItems.FirstOrDefault()?.Path" style="width: 300px; max-width: 100%" />
                                <br />
                                <input type="hidden" name="MediaId" alt="Submit" class="shareImage form-control" value="@post.PostMediaItems.FirstOrDefault()?.Path">
                            }
                            else
                            {
                                <h5 class="mb-3 control-label" style="font-weight: bold">
                                    لا بوجد ميديا
                                </h5>
                                <div>
                                    <img src="~/Static/Images/no-img.jpg" style="border: 1px solid grey; width: 300px; max-width: 100%" />
                                </div>
                            }
                        </div>
                    </div>


                </div>

                <input type="hidden" value="@post.Id" name="PostId" />

            </form>


        </div>
    </div>

</div>

<div class="card ms-auto p-3 mt-4">

    <h3 class="card-title" style="text-align: left"> @AppResources.Label("Operations") </h3>

    @if (operation != null)
    {

        @foreach (var op in operation)
        {
            <div class="@((StatusEnum)op.Status == StatusEnum.Success ? "success" : "fail")">

                <div class="section">
                    <div class="section-title">Service</div>
                    <div class="section-info"> @op.Service?.ToString()</div>
                </div>

                <div class="section">
                    <div class="section-title">Messages</div>
                    <div class="section-info">
                        @{
                            var splitValue = "************************************************";

                            var message = op.Messages.Split(splitValue);
                            <div>@splitValue</div>
                            <div>@(message[1])</div>
                            <div>
                                @splitValue
                            </div>

                        }

                        @switch ((StatusEnum)op.Status)
                        {

                            case StatusEnum.Success:
                                <div>Succes</div>
                                break;

                            case StatusEnum.Failed:
                                <div>Failed</div>
                                break;

                            default:
                                break;
                        }

                        <div>@op.CurrentState?.ToString()</div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <p>No operations yet</p>
    }
</div>


<link rel="stylesheet" href="~/css/Posts/share.css" />
<script src="~/js/Posts/share.js"> </script>

<style>
    .section-title {
        width: 78px;
        text-align: left;
    }

    .section {
        display: flex;
        column-gap: 38px;
        margin-top: 12px;
        text-align: left;
        flex-direction: row-reverse;
        padding-left: 10px;
    }

    .section-info {
        display: flex;
        flex-direction: column;
        row-gap: 14px;
    }

    hr {
        width: 90%;
        margin-left: auto !important;
        margin-right: auto !important;
        margin-bottom: 40px;
    }

    .fail {
        background-color: #ffe1e1;
    }

    .success {
        background-color: #e1ffe6;
    }

    .fail, success {
        margin: 3px;
        padding-bottom: 40px;
    }

    .section p {
        direction: ltr;
    }

</style>