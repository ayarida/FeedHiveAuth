@using FeedHiveAuth.Areas.Social.Models;
@using Microsoft.AspNetCore.Identity;
@using FeedHiveAuth.Models.Enums;
@using FeedHiveAuth.Data.Helpers

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@model FeedHiveAuth.Models.Post

@{
    var post = Model;
    var operation = post.Operations.OrderBy(o => o.CreationDate).Reverse();
    Layout = "~/Views/Shared/_Layout.cshtml";
    var configs = SocialServiceHelper.getSocialConfigs();
    var defaultimg = configs.TechnicalConfigs?.appTechnicalConfigs?.DefaultImageUrl ?? "";
    ViewData["Title"] = "Preview";
}

<div class="d-flex flex-wrap create popup-media">
    <div class="p-3 col-md-10 col-sm-12 createForm">
        
        <form id="form-share" method="post" action="send" style="max-width: 100%; width: 100%" dir="rtl">
            
            <div class="createUpper">
                <div class="container-create-header">
                    <div class="header-text">
                        <h2>استعراض المنشور</h2>
                        <p class="text-muted">مراجعة التفاصيل قبل النشر</p>
                    </div>

                    <div class="post-actions">
                        <a href="/Social/Publish/Share?postid=@post.Id" class="submit-button btn btn-primary save-submit" style="text-decoration: none;">
                            <span>@AppResources.Label("share", "ar")</span>
                            <i class="bi bi-share ms-2"></i>
                        </a>

                        <a href="/Posts/Edit/@post.Id" class="edit-btn">
                            @AppResources.Label("edit", "ar") 
                            <i class="bi bi-pencil-square ms-1"></i>
                        </a>

                        <a href="/Home/Index" class="back-home">
                            @AppResources.Label("back") 
                            <icon name="back" size="25"></icon>
                        </a>
                    </div>
                </div>

                <div class="form-body">
                    <div class="row">
                        <div class="col-md-7">
                            <div class="form-group mb-4">
                                <label class="control-label">عنوان المنشور</label>
                                <input class="form-control" value="@post.Title" name="Data[0].Text" readonly type="text" />
                            </div>

                            <div class="form-group mb-4">
                                <label class="control-label">عنوان قصير</label>
                                <input value="@post.ShortTitle" name="ShortTitle" readonly type="text" class="form-control" />
                            </div>

                            <div class="form-group mb-4">
                                <label class="control-label">ملخص</label>
                                <input value="@post.Summary" name="Summary" readonly class="form-control" />
                            </div>

                            <div class="form-group mb-4">
                                <label class="control-label">محتوى</label>
                                <textarea readonly class="form-control" style="height: 120px">@post.Content</textarea>
                            </div>
                            
                            <div class="form-group mb-4">
                                <label class="control-label">وقت النجدولة</label>
                                <input class="form-control" type="datetime-local" id="ScheduleTime" name="Data[0].ScheduleTime" value="">
                            </div>
                        </div>

                        <div class="col-md-5">
                            <label class="control-label mb-3">الوسائط المتعددة</label>
                            <div class="d-flex flex-wrap gap-3">
                                @if (post.PostMediaItems != null && post.PostMediaItems.Count > 0)
                                {
                                    foreach (var media in post.PostMediaItems)
                                    {
                                        <div class="media-container">
                                            @if (media.Type == 10) // Image
                                            {
                                                <div class="uploaded-img">
                                                    <img src="@media?.Path" />
                                                    <div onclick="deletePostMedia('@media.Id','@post.Id')" class="deleteIcon">
                                                        <i class="bi bi-trash3-fill"></i>
                                                    </div>
                                                </div>
                                            }
                                            @if (media.Type == 30) // Video
                                            {
                                                <div class="video-holder uploaded-img">
                                                    <iframe src="@media?.Path" allowfullscreen style="width: 100%; height: 100%"></iframe>
                                                     <div onclick="deletePostMedia('@media.Id','@post.Id')" class="deleteIcon">
                                                        <i class="bi bi-trash3-fill"></i>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                    <input type="hidden" name="MediaId" class="shareImage" value="@post.PostMediaItems.FirstOrDefault()?.Path">
                                }
                                else
                                {
                                    <div class="text-center w-100">
                                        <p class="text-muted">لا يوجد ميديا</p>
                                        <img src="@defaultimg" class="default-img-preview" />
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <input type="hidden" value="@post.Id" name="PostId" />
        </form>

        <div class="mt-4 p-3 operations-card">
            <h3 class="card-title mb-3">@AppResources.Label("PostOperations")</h3>
            @if (operation != null && operation.Any())
            {
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Service</th>
                                <th>Status</th>
                                <th>Message</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var op in operation)
                            {
                                <tr class="@((StatusEnum)op.Status == StatusEnum.Success ? "table-success" : "table-danger")">
                                    <td>@op.Service?.ToString()</td>
                                    <td>
                                        @if((StatusEnum)op.Status == StatusEnum.Success) { <span class="badge bg-success">Success</span> }
                                        else { <span class="badge bg-danger">Failed</span> }
                                    </td>
                                    <td>
                                        @{
                                            var msg = op.Messages;
                                            if(msg.Contains("************************************************")) {
                                                msg = msg.Split(new[] { "************************************************" }, StringSplitOptions.None)[1];
                                            }
                                        }
                                        @msg
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted">No operations recorded yet.</p>
            }
        </div>

    </div>
</div>

<link rel="stylesheet" href="~/css/Posts/share.css" />
<script src="~/js/Posts/share.js"></script>