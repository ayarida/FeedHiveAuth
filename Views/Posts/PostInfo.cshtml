@using FeedHiveAuth.Data.Helpers
@model FeedHiveAuth.Models.Post
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    Post post = Model;

}


<h2 dir="rtl">@AppResources.Label("UpdateContent") @post?.Title</h2>

<hr />

<main class="editor">
    <div class="container pt-4 mt-4">
        <div class="card px-4 py-5" style="background: white">

            <div class="row">
                <div class="create-post">
                    <div class="card-head my-2">

                        <form asp-route="/Posts/UpdatePostData/@post?.Id" enctype="multipart/form-data" method="post" style="max-width: 100%" dir="">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                            <div class="form-group mb-4">
                                <label asp-for="Title" class="control-label">@AppResources.Label("Title")</label>
                                <input asp-for="Title" class="form-control" />
                                <span asp-validation-for="Title" class="text-danger"></span>
                            </div>
                            <div class="form-group mb-4">
                                <label asp-for="ShortTitle" class="control-label">@AppResources.Label("ShortTitle")</label>
                                <input asp-for="ShortTitle" class="form-control" />
                                <span asp-validation-for="ShortTitle" class="text-danger"></span>
                            </div>
                            <div class="form-group mb-4">
                                <label asp-for="Summary" class="control-label">@AppResources.Label("Summary")</label>
                                <input asp-for="Summary" class="form-control" />
                                <span asp-validation-for="Summary" class="text-danger"></span>
                            </div>
                            <div class="form-group mb-4">
                                <label asp-for="Content" class="control-label">@AppResources.Label("Content")</label>
                                <input asp-for="Content" class="form-control" />
                                <span asp-validation-for="Content" class="text-danger"></span>
                            </div>
                            <div class="form-group mb-4">
                                <label asp-for="PostDate" class="control-label">@AppResources.Label("PostDate")</label>
                                <input asp-for="PostDate" class="form-control" />
                                <span asp-validation-for="PostDate" class="text-danger"></span>
                            </div>
                            <div style="display: flex;align-items: center;column-gap: 20px;" class="my-5">
                                <div class="mb-3" style="width: 78px;">@AppResources.Label("VideoPhoto")</div>
                                <label class="custom-file-upload mb-3" style="border-radius: 10px;border-color: var(--blue-color);box-shadow: 0px 3px 6px #00000029;background: white;">
                                   @AppResources.Label("Upload")
                                    <i class="bi bi-cloud-arrow-up-fill" style="font-size: 25px;color: var(--blue-color);margin-right: 5px;"></i>
                                    <input type="file" name="File" id="imgInput" />
                                </label>
                                <img id="imgPreview" src="" style="width: 400px; max-width: 100%" />
                            </div>
                            <div class="form-group mb-4">
                                <input type="submit" value="@AppResources.Label("Update")" class="btn btn-primary update" style="max-width: 50%;width: 100%; border-radius: 28px;" />
                            </div>

                            @* <textarea class="content-area" name="example"></textarea> *@
                        </form>


                    </div>
                </div>
            </div>

        </div>
    </div>

</main>


<script>
    imgInput.onchange = evt => {
        const [file] = imgInput.files
        if (file) {
            imgPreview.src = URL.createObjectURL(file)
        }
    }
</script>

<style>

    input.update {
        display: block;
        margin: auto;
    }

    .card-head {
        justify-content: end;
    }

    input {
        text-align: start;
    }

</style>

<style>
    .card-head {
        justify-content: start;
    }

    .control-label {
        margin-bottom: 10px;
    }

    .custom-file-upload {
        width: 22%;
    }


    input {
        border-radius: 5px !important;
    }

    .star:after {
        font-size:20px;
        content: " *";
        color: red;
    }


    input, textarea {
        width: 510px !important;
        max-width: 100%;
        border-color: #212c37 !important;
        text-align: right;
    }

</style>
