@model FeedHiveAuth.Models.Post
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var model = Model;
    string[] imgExtenstions = { "png", "jpg", "jpeg" };
    var mediaItems = model.PostMediaItems;
}

<div dir="rtl">
    <h2>تعديل محتوى:</h2>
    <h3> @Model?.Title </h3>
</div>
<hr />

<div class="container pt-4 mt-4 editor">
    <div class="card px-4 py-5" style="width: fit-content">

        <div class="row">
            <div class="create-post">
                <div class="card-head my-2">

                    <form asp-controller="Posts" asp-action="Update" senctype="multipart/form-data" method="post" style="max-width: 100%">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="form-group mb-4">
                            <label asp-for="Title" class="control-label">عنوان</label>
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>
                        <div class="form-group mb-4">
                            <label asp-for="ShortTitle" class="control-label">عنوان قصير</label>
                            <input asp-for="ShortTitle" class="form-control" />
                            <span asp-validation-for="ShortTitle" class="text-danger"></span>
                        </div>
                        <div class="form-group mb-4">
                            <label asp-for="Summary" class="control-label">ملخص</label>
                            <input asp-for="Summary" class="form-control" />
                            <span asp-validation-for="Summary" class="text-danger"></span>
                        </div>
                        <div class="form-group mb-4">
                            <label asp-for="Content" class="control-label">محتوى</label>
                            <textarea asp-for="Content" class="form-control"></textarea>
                            <span asp-validation-for="Content" class="text-danger"></span>
                        </div>
                        <div class="form-group mb-4">
                            <label asp-for="PostDate" class="control-label">تاريخ النشر</label>
                            <input asp-for="PostDate" class="form-control" />
                            <span asp-validation-for="PostDate" class="text-danger"></span>
                        </div>
                        <div style="display: flex;align-items: center;column-gap: 20px;" class="my-5">
                            <div class="mb-3" style="width: 78px;">صورة / فيديو</div>
                            <label class="custom-file-upload mb-3" style="border-radius: 10px;border-color: var(--blue-color);box-shadow: 0px 3px 6px #00000029;background: white;">
                                تحميل
                                <i class="bi bi-cloud-arrow-up-fill" style="font-size: 25px;color: var(--blue-color);margin-right: 5px;"></i>
                                <input type="file" name="File" id="imgInput" />
                            </label>
                            <br />
                        </div>
                        <input type="hidden" asp-for="Id" class="form-control" value="@Model.Id" />
                        @*         <div>
                        <img id="imgPreview" src="" style="width: 400px; max-width: 100%" />
                        </div> *@
                        @if (model.PostMediaItems != null)
                        {
                            @foreach (var media in mediaItems)
                            {
                                @* if (media.ToString().Contains()) *@
                                bool isImg = new String[] { "png", "jpg", "jpeg" }.Any(s => media.Path.ToString().Contains(s));
                                <span>@isImg</span>
                            }
                        }
                        <div class="form-group my-4">
                            <input type="submit" value="تحديث" class="btn btn-primary update" style="max-width: 50%;width: 100%; border-radius: 28px;" />
                        </div>
                    </form>


                </div>
            </div>
        </div>

    </div>
</div>




<script>
    imgInput.onchange = evt => {
        const [file] = imgInput.files
        if (file) {
            imgPreview.src = URL.createObjectURL(file)
        }
    }
</script>

<style>

    input.update {
        display: block;
        margin: auto;
    }

    .card-head {
        justify-content: end;
    }

    input {
        text-align: start;
    }

    .card-head {
        justify-content: start;
    }

    .control-label {
        margin-bottom: 10px;
    }



    input {
        border-radius: 5px !important;
    }

    .star:after {
        content: " *";
        color: red;
    }


    input, textarea {
        width: 510px !important;
        max-width: 100%;
        border-color: #212c37 !important;
        text-align: right;
    }


    form > div {
        width: fit-content;
        margin: auto;
    }

</style>
