@model FeedHiveAuth.Models.Post
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var model = Model;
    string[] imgExtenstions = { "png", "jpg", "jpeg" };
    var mediaItems = model.PostMediaItems;
}

<div dir="rtl">
    <h2>تعديل محتوى:</h2>
    <h3> @Model?.Title </h3>
</div>
<hr />

<div class="container pt-4 mt-4 editor">
    <div class="card px-4 py-5">

        <div class="row">
            <div class="create-post">
                <div class="card-head my-2">

                    <form asp-controller="Posts" asp-action="Update" senctype="multipart/form-data" method="post" style="max-width: 100%; width: 100%">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="form-group mb-4">
                            <label asp-for="Title" class="control-label">عنوان</label>
                            <input asp-for="Title" class="form-control req" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>
                        <div class="form-group mb-4">
                            <label asp-for="ShortTitle" class="control-label">عنوان قصير</label>
                            <input asp-for="ShortTitle" class="form-control" />
                            <span asp-validation-for="ShortTitle" class="text-danger"></span>
                        </div>
                        <div class="form-group mb-4">
                            <label asp-for="Summary" class="control-label">ملخص</label>
                            <input asp-for="Summary" class="form-control" />
                            <span asp-validation-for="Summary" class="text-danger"></span>
                        </div>
                        <div class="form-group mb-4">
                            <label asp-for="Content" class="control-label">محتوى</label>
                            <textarea asp-for="Content" class="form-control"></textarea>
                            <span asp-validation-for="Content" class="text-danger"></span>
                        </div>
                        <div class="form-group mb-4">
                            <label asp-for="PostDate" class="control-label">تاريخ النشر</label>
                            <input asp-for="PostDate" class="form-control req" />
                            <span asp-validation-for="PostDate" class="text-danger"></span>
                        </div>

                        <partial name="_imagePreviewEdit" />
                        <input type="hidden" asp-for="Id" class="form-control" value="@Model?.Id" />

                        <div class="form-group mb-4 d-flex justify-content-center">
                            <div class="btn btn-primary my-4 submit-div">
                                <input type="submit" value="تحديث" class="update submit-button" />
                                <i class="bi bi-floppy"></i>
                            </div>
                        </div>
                    </form>


                </div>
            </div>
        </div>

    </div>
</div>


<link rel="stylesheet" href="~/css/Posts/edit.css" />