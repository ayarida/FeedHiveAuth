@using FeedHiveAuth.Models.ViewModels;
@model IEnumerable<ApplicationUser>
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    var Admins = Model;

}
<div class="row">
    <div class="card" dir="rtl">
        <div class="card-body">
            <div class="card-list">
                @foreach (var admin in Admins)
                {
                    <div class="card px-4 pt-4 card-access">
                        <h5 class="card-title">@admin.UserName</h5>
                        <hr />
                        <div class="card-body"> <p>منشورات من :</p> @Html.ActionLink("Editors", "AllPosts", "Posts", new { id = admin.Id })</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="~/css/posts/admins.css" />            