@model List<FeedHiveAuth.Models.Post>
@using FeedHiveAuth.Data;
@using FeedHiveAuth.Models.Enums
@using FeedHiveAuth.Data.Extensions
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    List<Post> posts = Model;
    var _mediaService = Instances.Repositories.MediaItemRepository;
}





<div class="col-md-12">
    <div class="card">

        @*      <div class="card-header">
        منشورات
        </div> *@

        <div class="card-body filterable" style="max-width: 100%;overflow: auto;">



            <table id="filter" class="table" dir="rtl">
            <table id="filter" class="table" dir="rtl">
                <thead>
                    <tr class="filters">
                        <th><input type="checkbox" name="selectAll" class="check" onClick="toggle(this)"></th>
                        <th>ميديا</th>
                        <th><input type="text" class="form-control" placeholder="عنوان" disabled /></th>
                        <th><input type="text" class="form-control" placeholder="عنوان قصير" disabled /></th>
                        <th>الحالة</th>
                        <th><input type="text" class="form-control" placeholder="التاريخ" disabled /></th>
                        <th>عمليات</th>
                    </tr>
                </thead>
                <div class="action-buttons">
                    <button class="btn btn-default btn-xs btn-filter" style="font-weight: bold;background: #f8f8f8;">
                        تصفية الخيارات
                        <i class="bi bi-filter"></i>
                    </button>
                    <button type="button" class="delete-btn" onClick="deleteSelected()" style="width: fit-content">حذف<i class="bi bi-trash me-2"></i> </button>
                    @*   <button type="button" class="publish-btn" onClick="publishSelected()">نشر</button> *@
                </div>

                <tbody>

                    @if (posts.Any())
                    {
                        @foreach (var post in posts)
                        {
                        //var mediapostId = _mediaService.GetMediaByPostId(post.Id)!=null ? _mediaService.GetMediaByPostId(post.Id).Id : "" ;
                            @*  var shareIcon = "< i class='bi bi-penc0il-square'></i>"; *@
                            <tr>


                                <td> <input type="checkbox" class="check" value="@post.Id"></td>
                                @if (post.PostMediaItems != null && post.PostMediaItems.Count != 0)
                                {
                                    <td><img src="@post.PostMediaItems?.FirstOrDefault()?.Path" /></td>
                                }
                                else
                                {
                                    <td><img src="~/uploads/no-img.jpg" style="border: 1px solid grey;" /></td>
                                }
                                <td class="post-title">@Html.ActionLink(post.Title, "Edit", "Posts", new { @post.Id })</td>
                                <td>@post.ShortTitle</td>
                                <td>

                                    @{
                                        var postStatus = EnumExtension.FromValue<StatusEnum>(post.Status);
                                    }

                                    @if (postStatus.ToString() == "New")
                                    {
                                        <div class="status status_new">
                                            @postStatus
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="status status_published">
                                            @postStatus
                                        </div>
                                    }

                                </td>

                                <td dir="ltr" style="text-align: right">@post.PostDate</td>
                                <td class="operations">
                                    <div>
                                        <div><a href="/Posts/Edit/@post.Id"><i class="bi bi-pencil" style="color: #1B5EE1"></i></a></div>
                                        <a href="/Social/Publish/Share?postid=@post.Id"><i class="bi bi-share-fill"></i></a>
                                        @if (postStatus.ToString() == "New")
                                        {
                                            <div onclick="deletePost(this.id)" id="@post.Id"><i class="bi bi-trash3-fill" style="cursor: pointer"></i></div>
                                        }
                                        else
                                        {
                                            <div id="@post.Id" style="pointer-events: none; width: fit-content"><i class="bi bi-trash3-fill" style="color: grey"></i></div>
                                        }
                                    </div>
                                </td>

                                @* <td></td> *@

                            </tr>
                        }
                    }
                </tbody>
            </table>

        </div>

    </div>
</div>





<style>

    i.bi.bi-trash3-fill {
        color: #e11b1b;
    }

    main input {
        max-width: 100%;
        margin-bottom: 20px;
        border: none;
        border-radius: 5px;
    }

    ::placeholder {
        color: black;
        opacity: 0.4;
    }

    .check {
        width: 20px;
        height: auto;
        box-shadow: none;
    }

    .action-buttons {
        display: flex;
        justify-content: space-between;
        width: 100%;
    }

        .action-buttons button {
            width: 200px;
            height: fit-content;
            padding: 7px 20px !important;
        }


    a {
        color: initial;
    }

    .navbar > .container, .navbar > .container-fluid, .navbar > .container-lg, .navbar > .container-md, .navbar > .container-sm, .navbar > .container-xl, .navbar > .container-xxl {
        flex-direction: row !important;
    }

    main input {
        margin-bottom: 0px;
    }

    .filter input {
        border: 1px solid black;
        text-align: right;
        padding-right: 10px;
        width: 310px;
    }

    .status {
        text-align: center;
        display: flex;
        justify-content: center;
        color: white;
        padding: 8px;
        border-radius: 4px;
    }

/*         .status.status_published {
            background-color: #baffc9;
            color: #136825;
        } */


    #empty-delete-error .modal-body {
        background-color: #dfaa0f;
    }


  /*   .status.status_new {
        background-color: #bae1ff;
        color: #294c66;
    } */

    .card-body.filterable input {
        text-align: right;
    }

    .filterable .filters input[disabled] {
        font-weight: bold;
    }

    .filterable .filters input {
        height: fit-content;
        border-radius: 0;
        border: 0;
        border-bottom: 1px solid;
        box-shadow: none;
    }

    button.btn.btn-secondary.close-popup {
        width: 140px;
    }

    .warning {
        background-color: #dfaa0f !important;
    }

    .error {
        background-color: var(--delete-color) !important;
    }

    td img {
        width: 78px;
        height: 50px;
    }

    td.operations > div {
        display: flex;
        column-gap: 10px;
        height: 40px;
        justify-content: center;
        align-items: center;
    }

    td.post-title a {
        text-underline-offset: 5px;
        text-decoration-color: #0a2c3f;
        text-decoration-thickness: 1px;
    }

</style>

