@model List<FeedHiveAuth.Models.Post>
@using FeedHiveAuth.Data;
@using FeedHiveAuth.Models.Enums
@using FeedHiveAuth.Data.Extensions
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    List<Post> posts = Model;
    var _mediaService = Instances.Repositories.MediaItemRepository;
}





<div class="col-md-12">
    <div class="card">

   @*      <div class="card-header">
            منشورات
        </div> *@

        <div class="card-body filterable" style="max-width: 100%;overflow: auto;">

            @*         <div style="margin-bottom: 20px;max-width: 100%; display: flex;flex-wrap: wrap;column-gap: 10px; row-gap: 10px" class="filter" dir="rtl">

            <input type="text" id="filter0" placeholder="التصفية حسب العنوان">
            <input type="text" id="filter1" placeholder="التصفية حسب العنوان القصير">
            <input type="text" id="filter3" placeholder="التصفية حسب التاريخ">



            </div> *@

            <table id="filter" class="table" dir="rtl">
                <thead>
                    <tr class="filters">
                        <th><input type="checkbox" name="selectAll" class="check" onClick="toggle(this)"><lablel for="selectAll"> الكل</lablel></th>
                        @* <th>ميديا</th> *@
                        <th><input type="text" class="form-control" placeholder="عنوان" disabled /></th>
                        <th><input type="text" class="form-control" placeholder="عنوان قصير" disabled /></th>
                        <th>الحالة</th>
                        <th>سوشال ميديا</th>
                        <th><input type="text" class="form-control" placeholder="التاريخ" disabled /></th>
                        <th>عمليات</th>
                    </tr>
                </thead>
                <div class="action-buttons">
                    <button class="btn btn-default btn-xs btn-filter" style="font-weight: bold;background: #f8f8f8;">
                        تصفية الخيارات
                        <i class="bi bi-filter"></i>
                    </button>
                    <button type="button" class="delete-btn" onClick="deleteSelected()" style="width: fit-content">مسح<i class="bi bi-trash me-2"></i> </button>
                    @*   <button type="button" class="publish-btn" onClick="publishSelected()">نشر</button> *@
                </div>

                <tbody>

                    @if (posts.Any())
                    {
                        @foreach (var post in posts)
                        {
                            //var mediapostId = _mediaService.GetMediaByPostId(post.Id)!=null ? _mediaService.GetMediaByPostId(post.Id).Id : "" ;
                            var shareIcon = "< i class='bi bi-penc0il-square'></i>";
                            <tr>

                                <td> <input type="checkbox" class="check" value="@post.Id"></td>
                                @* <td><img src="" /></td> *@
                                <td>@Html.ActionLink(post.Title, "Edit", "Posts", new { @post.Id })</td>
                                <td>@post.ShortTitle</td>
                                <td>

                                    @{
                                        var postStatus = EnumExtension.FromValue<StatusEnum>(post.Status);
                                    }

                                    @if (postStatus.ToString() == "New")
                                    {
                                        <div class="status status_new">
                                            @postStatus
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="status status_published">
                                            @postStatus
                                        </div>
                                    }

                                </td>
                                <td><i class="bi bi-facebook"></i><i class="bi bi-twitter-x"></i></td>

                                <td>@post.PostDate</td>
                                <td>
                                    <a href="/Posts/Edit/@post.Id"><i class="bi bi-pencil-square"></i></a>
                                    <a href="/Social/Publish/Share?postid=@post.Id"><i class="bi bi-share-fill"></i></a>
                                </td>

                                @* <td></td> *@

                            </tr>
                        }
                    }
                </tbody>
            </table>

        </div>

    </div>
</div>


<div class="modal fade" id="success-message" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-body">
                Selected Messages Deleted
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary close-popup" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="success-message-published" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-body">
                Selected Messages Published
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary close-popup" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="error-message" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-body">
                !An error occured please try again
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary close-popup" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>




<style>



    main input {
        max-width: 100%;
        margin-bottom: 20px;
        border: none;
        border-radius: 5px;
    }

    ::placeholder {
        color: black;
        opacity: 0.4;
    }

    .check {
        width: 20px;
        height: auto;
        box-shadow: none;
    }

    .action-buttons {
        display: flex;
        justify-content: space-between;
        width: 100%;
    }

        .action-buttons button {
            width: 200px;
        }


    a {
        color: initial;
    }

    .navbar > .container, .navbar > .container-fluid, .navbar > .container-lg, .navbar > .container-md, .navbar > .container-sm, .navbar > .container-xl, .navbar > .container-xxl {
        flex-direction: row !important;
    }

    main input {
        margin-bottom: 0px;
    }

    .filter input {
        border: 1px solid black;
        text-align: right;
        padding-right: 10px;
        width: 310px;
    }

    .status {
        text-align: center;
        display: flex;
        justify-content: center;
        color: white;
        padding: 8px;
        border-radius: 4px;
    }

        .status.status_published {
            background-color: #31bd36;
        }

        .status.status_new {
            background-color: var(--bs-blue);
        }

    .card-body.filterable input {
        text-align: right;
    }

    .filterable .filters input[disabled] {
        font-weight: bold;
    }

    .filterable .filters input {
        height: fit-content;
        border-radius: 0;
        border: 0;
        border-bottom: 1px solid;
        box-shadow: none;
    }
</style>

