@model List<FeedHiveAuth.Models.Post>
@using FeedHiveAuth.Models.Enums
@using FeedHiveAuth.Data.Extensions
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    List<Post> posts = Model;

}


<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>

<div class="col-md-12">
    <div class="card">

        <div class="card-header">
            Post history
        </div>
        <div class="card-body" style="max-width: 100%;overflow: scroll;">

            <div style="margin-bottom: 20px;max-width: 100%;">

                <input type="text" id="filter0" placeholder="Filter By Title">
                <input type="text" id="filter1" placeholder="Filter By ShortTitle">
                <input type="text" id="filter2" placeholder="Filter By Content">
                <input type="text" id="filter3" placeholder="Filter By Date">
                <input type="text" id="filter4" placeholder="Filter By Status">

            </div>

            <table id="filter" class="table">
                <thead>
                    <tr>
                        <th><input type="checkbox" name="selectAll" class="check" onClick="toggle(this)"><lablel for="selectAll">Select All</lablel></th>
                        <th>Title</th>
                        <th>ShortTitle</th>
                        <th>Content</th>
                        <th>Date</th>
                        <th>Edit</th>
                        <th>Status</th>

                    </tr>
                </thead>
                <div class="action-buttons">

                    <button type="button" class="delete-btn" onClick="deleteSelected()">Delete</button>
                    <button type="button" class="publish-btn"  onClick="publishSelected()">Publish</button>
                </div>

                <tbody>

                    @if (posts.Any())
                    {



                        @foreach (var post in posts)
                        {

                            <tr>
                                <td> <input type="checkbox" class="check" value="@post.Id"></td>
                                <td>@Html.ActionLink(post.Title,"PostInfo","Posts", new{@post.Id})</td>
                                <td>@post.ShortTitle</td>
                                <td>@post.Content</td>
                                <td>@post.PostDate</td>
                                <td><a href="#" style="color: inherit;"><i class="bi bi-pencil-square"></i></a></td>
                                <td>@(EnumExtension.FromValue<StatusEnum>(post.Status).Key())</td>

                            </tr>

                        }

                    }
                </tbody>
            </table>

        </div>

    </div>
</div>


<div class="modal fade" id="success-message" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-body">
                Selected Messages Deleted
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary close-popup" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="success-message-published" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-body">
                Selected Messages Published
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary close-popup" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="error-message" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-body">
                An error occured please try again !
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary close-popup" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>


