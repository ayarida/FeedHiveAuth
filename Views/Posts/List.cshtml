@model PostListViewModel
@using FeedHiveAuth.Data;
@using FeedHiveAuth.Data.Helpers;
@using FeedHiveAuth.Models.Enums
@using FeedHiveAuth.Data.Extensions
@using FeedHiveAuth.Models.ViewModels;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    List<Post> posts = Model.allPosts;
    var _mediaService = Instances.Repositories.MediaItemRepository;
    var configs = SocialServiceHelper.getSocialConfigs();
    var defaultimg = configs.TechnicalConfigs?.appTechnicalConfigs?.DefaultImageUrl ?? "";
}


<div class="col-md-12">
    <div class="card">

        @*      <div class="card-header">
        منشورات
        </div> *@

        <div class="card-body filterable" style="max-width: 100%;overflow: auto;">


            <table id="filter" class="table" dir="rtl">
                <thead>
                    <tr class="filters">
                        <th>
                            <input type="checkbox" name="selectAll" class="check" onClick="toggle(this)">
                        </th>
                        <th></th>
                        <th>
                            <input type="text" class="form-control" placeholder="@AppResources.Label("Title")" disabled />
                        </th>
                        <th>
                            <input type="text" class="form-control" placeholder="@AppResources.Label("ShortTitle")" disabled />
                        </th>
                        <th>@AppResources.Label("CreatedBy")</th>
                        <th>
                            <input type="text" class="form-control" placeholder="التاريخ" disabled />
                        </th>
                        <th>@AppResources.Label("Operations")</th>
                    </tr>
                </thead>
                <div class="action-buttons">
                    <button class="btn btn-default btn-xs btn-filter" style="font-weight: bold;background: #f8f8f8;">
                        @AppResources.Label("FilterChoices")
                        <i class="bi bi-filter"></i>
                    </button>
                    <button type="button" class="delete-btn" onClick="deleteSelected()" style="width: fit-content">@AppResources.Label("Delete")<i class="bi bi-trash me-2"></i> </button>
                    @*   <button type="button" class="publish-btn" onClick="publishSelected()">نشر</button> *@
                </div>

                <tbody>

                    @if (posts.Any())
                    {
                        @foreach (var post in posts)
                        {
                        //var mediapostId = _mediaService.GetMediaByPostId(post.Id)!=null ? _mediaService.GetMediaByPostId(post.Id).Id : "" ;
                            @*  var shareIcon = "< i class='bi bi-penc0il-square'></i>"; *@


                            var postStatus = EnumExtension.FromValue<StatusEnum>(post.Status);


                            <tr>


                                <td>
                                    <input type="checkbox" class="check" value="@post.Id" @(postStatus.ToString() == "New" ? "" : "disabled")>
                                </td>
                                @if (post.PostMediaItems != null && post.PostMediaItems.Count != 0)
                                {
                                    <td>
                                        <img src="@post.PostMediaItems?.FirstOrDefault()?.Path" />
                                    </td>
                                }
                                else
                                {
                                    <td>
                                        <img src="@defaultimg" style="border: 1px solid grey;" />
                                    </td>

                                }
                                <td class="post-title">
                                    <div>
                                        @Html.ActionLink(post.Title, "Preview", "Posts", new { @post.Id })

                                        @if (post.Operations != null)
                                        {
                                            var uniqueServices = new HashSet<String>();
                                            <div class="mt-3">
                                                @foreach (var postChannel in post.Operations)
                                                {
                                                    var service = postChannel?.Service?.ToString();
                                                    if (service != null && uniqueServices.Add(service))
                                                    {
                                                        <i class="bi bi-@(postChannel?.Service?.ToString() == " dailymotion" ? "camera-video" : @postChannel?.Service?.ToString()) "></i>
                                                    }

                                                }
                                            </div>
                                        }
                                    </div>
                                </td>
                                <td>@post.ShortTitle</td>
                                <td style="text-align: right">

                                    @post.CreatedByName

                                </td>

                                <td dir="ltr" style="text-align: right">@post.PostDate</td>
                                <td class="operations">
                                    <div>
                                        <div>
                                            <a href="/Posts/Edit/@post.Id">
                                                <i class="bi bi-pencil" style="color: #1B5EE1"></i>
                                            </a>
                                        </div>
                                        <a href="/Social/Publish/Share?postid=@post.Id">
                                            <i class="bi bi-share-fill"></i>
                                        </a>
                                        @if (postStatus.ToString() == "New")
                                        {
                                            <div onclick="deletePost(this.id)" id="@post.Id">
                                                <i class="bi bi-trash3-fill" style="cursor: pointer"></i>
                                            </div>
                                        }
                                        else
                                        {
                                            <div id="@post.Id" style="pointer-events: none; width: fit-content">
                                                <i class="bi bi-trash3-fill" style="color: grey"></i>
                                            </div>
                                        }
                                    </div>
                                </td>

                                @* <td></td> *@

                            </tr>
                        }
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>



<link rel="stylesheet" href="~/css/Posts/list.css" />



<link rel="stylesheet" href="~/css/Filter.css" />
<script type="text/javascript" src="~/js/Sidebar/mdb.js"></script>
<script src="~/js/Posts/list.js"></script>