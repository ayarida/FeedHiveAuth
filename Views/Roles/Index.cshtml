@model IEnumerable<IdentityRole>
@{
    ViewData["Title"] = "ROLES";
}

<h1 class="text-black">كل الأدوار</h1>
<a asp-action="Create" class="btn btn-primary mt-2 mb-4 create-role">أنشئ دور +</a>
<div style="overflow-x:auto;">
    <table class="table table-sm table-bordered table-bordered">
        <tr><th>الاسم</th><th>المستخدمين</th><th>تحديث</th><th>حذف</th></tr>
        @foreach (var role in Model)
        {
            <tr>
                <td>@role.Name</td>
                <td i-role="@role.Id"></td>
                <td><a class="btn btn-sm btn-primary update-link" asp-action="Update" asp-route-id="@role.Id"><i class="bi bi-pencil-square"></i></a></td>
                <td>
                    <form asp-action="Delete" asp-route-id="@role.Id" method="post">
                        <button type="submit" class="btn btn-sm btn-danger delete-role">
                            <i class="bi bi-trash3-fill"></i>
                        </button>
                    </form>
                </td>
            </tr>
        }
    </table>
</div>

<style>
    .table.table-sm.table-bordered tr {
        text-align: center;
    }

    .table.table-sm.table-bordered td {
        vertical-align: middle;
    }

    .delete-role {
        width: fit-content;
        max-width: 100%;
        height: fit-content;
    }

    .update-link {
        background-color: var(--blue-color);
    }

    th {
        background: #F6F9FC !important;
    }

</style>