@using FeedHiveAuth.Data.Helpers
@model List<Role>
@{
    ViewData["Title"] = "Roles";
}

<a asp-action="Create" class="btn btn-primary mt-2 mb-4 create-role" style="border: none">أنشئ دور +</a>
<div style="overflow-x:auto;" class="card">
    <table class="role-table">
        <tr>
            <th>@AppResources.Label("Name")</th><th>@AppResources.Label("Description")</th><th>@AppResources.Label("Operations")</th>
        </tr>
        @foreach (var role in Model)
        {
            <tr>
                <td>@role.Name</td>
                <td>@role.Description</td>
                <td>
                    <a class="btn btn-sm btn-primary update-link" asp-action="Edit" asp-route-id="@role.Id">
                        <icon name="edit" size="25"></icon></a>
                    <a type="submit" onclick="deleteRole(this.id)" id="@role.Id" class="btn btn-sm btn-danger delete-role">
                        <icon name="delete" size="25">
                        </icon></a>
                </td>
            </tr>
        }
    </table>
</div>

<script src="~/js/Roles/Roles.js"></script>

<link rel="stylesheet" href="~/css/Roles/list.css"/>