@model string
@using FeedHiveAuth.Data.Helpers
@{
    ViewData["Title"] = "CREATE ROLE";
    var controllers = PermissionHelper.Controllers();
    //var actions = PermissionHelper.Actions(controllers.FirstOrDefault());
}

<div class="card p-3" dir="ltr" style="text-align: left">
    <div class="create-role">
        <div class="d-flex justify-content-between align-items-end flex-row-reverse" style="margin-bottom: 80px;">
            <h3 class="text-black">Create a Role</h3>
            <a class="btn btn-secondary" style="width: 125px;max-width: 100%;" href="/Roles/Index">
                Back
                <i class="bi bi-box-arrow-in-left"></i>
            </a>
        </div>
        @* <div asp-validation-summary="All" class="text-danger"></div> *@

        <form class="create-form" method="post" dir="ltr" method="post" id="role-form">
            <div class="form-group d-flex align-items-end justify-content-between mb-3" style="direction: ltr; column-gap: 10px">
                <div>
                    <label for="name" class="mb-3">Name :</label>
                    <input name="name" class="form-control" type="text" id="role-name" />
                </div>
            </div>

            <div class="form-group d-flex align-items-end justify-content-between" style="direction: ltr; column-gap: 10px">
                <div>
                    <label for="description" class="mb-3">Description :</label>
                    <input name="description" class="form-control" type="text" id="role-description" />
                </div>
                <button type="submit" class="btn btn-primary" style="width: fit-content">Create</button>
            </div>

            <h3 class="mt-5">Permissions</h3>

            <div class="form-group my-4 card p-3">

                <table dir="ltr">

                    @foreach (var controller in controllers.OrderBy(x => x.Value.Item2))
                    {
                        <tr>
                            <td id="@controller.Key.ToLower()"><h5>@controller.Key</h5></td>
                            <td>
                                <ul class="ks-cboxtags @(controller.Key.ToLower() + "data")">
                                    @foreach (var action in controller.Value.Item1)
                                    {
                                        @* <span>@action</span> *@
                                        <li>
                                            <input type="checkbox" id="@(controller.Key.ToLower())@action.ToString()" name="@action.ToString()" />
                                            <label for="@(controller.Key.ToLower())@action.ToString()">@action.ToString()</label>
                                        </li>
                                    }
                                </ul>
                            </td>
                        </tr>
                    }
                </table>
            </div>
        </form>
    </div>

</div>

