@model string
@using FeedHiveAuth.Data.Helpers
@{
    ViewData["Title"] = "CREATE ROLE";
    var controllers = PermissionHelper.Controllers();
    //var actions = PermissionHelper.Actions(controllers.FirstOrDefault());
}

<div class="card p-3" dir="ltr" style="text-align: left">
    <div class="create-role">

        @* <div asp-validation-summary="All" class="text-danger"></div> *@

        <form class="create-form" dir="ltr" id="role-form">
            <div class="d-flex align-items-end flex-row" style="margin-bottom: 80px;">
                <h3 class="text-black">أنشئ دور</h3>
                <button type="submit" class="btn btn-primary me-auto ms-2" style="width: 161px;height: fit-content;padding: 6px !important;" id="role-for">أنشئ</button>
                <a class="btn btn-secondary" style="width: fit-content;max-width: 100%;" href="/Roles/Index">
                    العودة إلى قائمة الأدوار
                    <i class="bi bi-box-arrow-in-left"></i>
                </a>
            </div>
            <div style="text-align: right">
                <div class="form-group ">
                    <div>
                        <label for="name" class="mb-4">الاسم :</label>
                        <input name="name" class="form-control" type="text" id="role-name" style="text-align: right"/>
                    </div>
                </div>

                <div class="form-group mt-3">
                    <div>
                        <label for="description" class="">الوصف :</label>
                        <input name="description" class="form-control" type="text" id="role-description" style="text-align: right"/>
                    </div>

                </div>
            </div>

            <h3 class="mt-5">Permissions</h3>

            <div class="form-group my-4 card p-3">

                <table dir="ltr">

                    @foreach (var controller in controllers.OrderBy(x => x.Value.Item2))
                    {
                        <tr>
                            <td id="@controller.Key.ToLower()">
                                <h5>@controller.Key</h5>
                            </td>
                            <td>
                                <ul class="ks-cboxtags @(controller.Key.ToLower() + "data")">
                                    @foreach (var action in controller.Value.Item1)
                                    {
                                        @* <span>@action</span> *@
                                        <li>
                                            <input value="@(action.ToString())" type="checkbox" id="@(controller.Key.ToLower())@action.ToString()" name="@(controller.Key.ToLower())"/>
                                            <label for="@(controller.Key.ToLower())@action.ToString()">@action.ToString()</label>
                                        </li>
                                    }
                                </ul>
                            </td>
                        </tr>
                    }
                </table>
            </div>
        </form>
    </div>

</div>

<script>
    document.getElementById('role-form').addEventListener('submit',
        function (event) {
        
            if (!$("#role-name").val()){
                event.preventDefault()
                   swal.fire({
                                customClass: {
                                    confirmButton: "btn btn-primary  warning",
                                },
                                title: "enter name role",
                                confirmButtonText: "ok",
                            });
                }
            
           else {
                        const formData = new FormData(event.target)
                        const authorizationJson = {
                           name:formData.get("name"),
                           description:formData.get("description"),
                           // authorization:formData.getAll("authorization"),
                           // channels:formData.getAll("channels"),
                           // configs:formData.getAll("configs"),
                           // home:formData.getAll("home"),
                           // mediaitem:formData.getAll("mediaitem"),
                           // oauthorization:formData.getAll("oauthorization"),
                           // posts:formData.getAll("posts"),
                           // publish:formData.getAll("publish"),
                           // roles:formData.getAll("roles"),
                           // socialhome:formData.getAll("socialhome"),
                           // subscriptions:formData.getAll("subscriptions"),
                           // users:formData.getAll("users")
                           
                           @foreach (var controller in controllers.OrderBy(x => x.Value.Item2))
                           {
                               @: '@controller.Key.ToLower()': formData.getAll('@controller.Key.ToLower()');
                           }
                       
                         event.preventDefault();
                         console.log(authorizationJson);    
                         axios.post('/roles/create', {
                           authorizationJson})
                           .then(function (response) {
                             console.log(response);
                           })
                           .catch(function (error) {
                             console.log(error);
                           });
                }
         
        });
</script>

<style>
    h2#swal2-title {
        direction: ltr;
    }


    tbody tr:not(:last-child) {
        border-bottom: 1px solid #dee2e6;
    }

    ul.ks-cboxtags {
        list-style: none;
        padding: 20px;
    }

        ul.ks-cboxtags li {
            display: inline;
        }

            ul.ks-cboxtags li label {
                display: inline-block;
                background-color: rgba(255, 255, 255, .9);
                border: 2px solid rgba(139, 139, 139, .3);
                color: #adadad;
                border-radius: 25px;
                white-space: nowrap;
                margin: 3px 0px;
                -webkit-touch-callout: none;
                -webkit-user-select: none;
                -moz-user-select: none;
                -ms-user-select: none;
                user-select: none;
                -webkit-tap-highlight-color: transparent;
                transition: all .2s;
            }

            ul.ks-cboxtags li label {
                padding: 8px 12px;
                cursor: pointer;
            }

                ul.ks-cboxtags li label::before {
                    display: inline-block;
                    font-style: normal;
                    font-variant: normal;
                    text-rendering: auto;
                    -webkit-font-smoothing: antialiased;
                    font-family: bootstrap-icons !important;
                    font-weight: 900;
                    font-size: 12px;
                    padding: 2px 6px 2px 2px;
                    content: "\F63B";
                    transition: transform .3s ease-in-out;
                }

            ul.ks-cboxtags li input[type="checkbox"]:checked + label::before {
                content: "\F633";
                transform: rotate(-360deg);
                transition: transform .3s ease-in-out;
            }

            ul.ks-cboxtags li input[type="checkbox"]:checked + label {
                /*  border: 2px solid #1bdbf8; */
                background-color: var(--green-status-back);
                color: var(--green-status-color);
                transition: all .2s;
            }

            ul.ks-cboxtags li input[type="checkbox"] {
                display: absolute;
            }

            ul.ks-cboxtags li input[type="checkbox"] {
                position: absolute;
                opacity: 0;
            }

    table h5 {
        margin-bottom: 100%;
        margin-top: 7px;
    }

    label {
        direction: ltr;
    }

</style>