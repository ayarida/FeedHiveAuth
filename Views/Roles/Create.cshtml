@model string
@using FeedHiveAuth.Data.Helpers
@{
    ViewData["Title"] = "CREATE ROLE";
    var controllers = PermissionHelper.Controllers();
    //var actions = PermissionHelper.Actions(controllers.FirstOrDefault());
}

<div class="create-role">
    <h1 class="text-black">Create a Role</h1>
    <a asp-action="Index" class="btn btn-secondary" style="width: 125px;max-width: 100%;">Back</a>
    <div asp-validation-summary="All" class="text-danger"></div>

    <form asp-action="Create" class="create-form" method="post">
        <div class="form-group mb-2">
            <label for="name">Name:</label>
            <input name="name" class="form-control" />
        </div>
        <button type="submit" class="btn btn-primary">Create</button>
    </form>
</div>
<div class="form-group mb-4">
    <h4>Permissions</h4>
    @foreach(var controller in controllers.OrderBy(x=>x.Value.Item2))
    {
        <h2>@controller.Key</h2>
        @foreach(var action in controller.Value.Item1)
        {
            <span>@action</span>
        }
    }
</div>

<style>
    .create-form * {
        width: 325px;
        max-width: 100%;
    }
</style>