@model List<OrganizationViewModel>

<h2>Organizations</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Created On</th>
            <th>Status</th>
            <th>Org Admins</th>
            <th>Editors</th>
            <th>Actions</th>
            <th>Formatted Date</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>
                    @item.CreationDate
                </td>
                <td>@item.Status</td>
                <td>@item.OrgAdminsCount</td>
                <td>@item.EditorsCount</td>
                <td>
                    <a href="@Url.Action("Edit", "Organization", new { id = item.Id })" class="btn btn-warning btn-sm">
                        Edit
                    </a>

                    <a href="@Url.Action("OrgDetails", "Organization", new { orgId = item.Id })" class="btn btn-primary btn-sm">
                        View OrgAdmins
                    </a>
                    <form asp-controller="Organization" asp-action="DeleteConfirmed"
                          asp-route-id="@item.Id"
                          method="post"
                          style="display:inline"
                          >

                        <button type="submit" class="btn btn-danger btn-sm">
                            Delete
                        </button>
                    </form>

                </td>
                <td>@item.CreatedOnFormatted</td>
            </tr>
        }
    </tbody>
</table>
