@model IEnumerable<ApplicationUser>

@{
    var org = ViewBag.Organization as FeedHiveAuth.Models.Organization;
    ViewData["Title"] = $"Admins of {org?.Name}";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Admins of @org?.Name</h2>

        <a asp-action="CreateAdmin"
           asp-route-orgId="@org.Id"
           class="btn btn-primary">
            Add Admin for @org.Name
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No admins found for this organization.
        </div>
    }
    else
    {
        <table class="table table-bordered table-striped">
            <thead class="table-light">
                <tr>
                    <th>UserName</th>
                    <th>Email</th>
                    <th>Status</th>
                    <th style="width: 180px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var admin in Model)
                {
                    <tr>
                        <td>@admin.UserName</td>
                        <td>@admin.Email</td>
                        <td>
                            @* @if (admin.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            } *@
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td>
                            <a asp-action="EditAdmin"
                               asp-route-id="@admin.Id"
                               class="btn btn-sm btn-warning">
                                Edit
                            </a>
                            <a asp-action="DeleteAdmin"
                               asp-route-id="@admin.Id"
                               onclick="return confirm('Are you sure you want to delete this admin?');"
                               class="btn btn-sm btn-danger">
                                Delete
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
