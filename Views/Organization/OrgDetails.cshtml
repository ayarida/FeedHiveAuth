@using FeedHiveAuth.Models.ViewModels
@model OrgDetailsViewModel

@{
    var orgId = @Model.OrganizationId;
}
<h3>@Model.OrganizationName – Admins & Editors</h3>

<hr />

<h3>Organization Hierarchy Tree</h3>
<a href="@Url.Action("Index", "Organization")"
   class="btn btn-success mb-3">
    Back to List
</a>
<a href="@Url.Action("CreateUser", "Organization", new { orgId = orgId })"
   class="btn btn-success mb-3">
    + Add Users
</a>

@foreach (var admin in Model.OrgAdmins)
{
    <div class="card mb-4 p-3">
        <h5>@admin.FullName (@admin.Email)</h5>

        <h6 class="mt-3">Editors</h6>

        <ul>
            @foreach (var editor in Model.Editors.Where(e => e.ParentId == admin.Id))
            {
                <li>@editor.FullName | @editor.Email</li>
            }
        </ul>
    </div>
}
