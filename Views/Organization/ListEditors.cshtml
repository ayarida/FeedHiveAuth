@model IEnumerable<ApplicationUser>

@{
    ViewData["Title"] = "Editors";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Editors - @ViewBag.OrganizationName</h2>

        <a asp-action="CreateEditor" class="btn btn-primary">
            Add Editor
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No editors found.</div>
    }
    else
    {
        <table class="table table-bordered table-striped">
            <thead class="table-light">
                <tr>
                    <th>UserName</th>
                    <th>Email</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var editor in Model)
                {
                    <tr>
                        <td>@editor.UserName</td>
                        <td>@editor.Email</td>
                        <td>
                           @*  @if (editor.isActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            } *@
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
