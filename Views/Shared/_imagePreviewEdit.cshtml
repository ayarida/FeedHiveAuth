@using FeedHiveAuth.Data.Helpers
@model FeedHiveAuth.Models.Post
@{
    var model = Model;
    var mediaItems = model.PostMediaItems;
}


<div id="existing-image">
    @if (model.PostMediaItems != null)
    {
        @foreach (var media in mediaItems)
        {
            @if (!media.Path.ToString().Contains(".mp4"))
            {
                <div class="uploaded-img">
                    <img alt="preview" src="@media.Path" />
                    <div onclick="deleteMedia(this)" class="deleteIcon">
                        <i class="bi bi-trash3-fill" style="cursor: pointer"></i>
                    </div>
                </div>
            }
            else
            {
                <div class="video-holder mt-3 w-100">
                    <video controls class="uploaded-img">
                        <source src="@media.Path" alt="placeholder" class="mb-3" type="video/mp4" />

                    </video>
                    <div onclick="deleteMedia(this)" class="deleteIcon">
                        <i class="bi bi-trash3-fill" style="cursor: pointer"></i>
                    </div>
                </div>
            }

        }
    }

</div>

