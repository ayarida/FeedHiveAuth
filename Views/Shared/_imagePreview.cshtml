@using FeedHiveAuth.Data.Helpers

<div style="display: flex;align-items: center;column-gap: 20px; flex-direction: column" class="my-5" id="media-section">

    <div class="mb-3" style="font-size: 20px; font-weight: bold">@AppResources.Label("Image") / @AppResources.Label("Video")</div>
    <div style="width: fit-content;background: #c8dadf; padding: 10px; width: 200px; border-radius: 3px;">
        <label class="custom-file-upload" style="border: 1px dashed black; ;">
            @AppResources.Label("Upload")
            <i class="bi bi-upload" style="color: #54696b;margin-right: 12px;"></i>
        </label>
        <input type="file" name="File" id="mediaInput" multiple />
    </div>


</div>




<script src="~/js/Posts/createPost.js"> </script>