@{
    var x = SignInManager.UserManager;
}
<ul class="navbar-nav d-flex flex-row nav-left greeting w-100 p-0">
    @if (SignInManager.IsSignedIn(User))
    {

        <a class="nav-link text-dark order-1 " asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage" style="font-size: 23px">مرحبًا @User.Identity?.Name !</a>

        <form class="form-inline me-auto order-3" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" class="nav-link btn btn-link text-dark log-out" style="height: auto">تسجيل خروج</button>
        </form>


        <a href="/Home/Index" class="">
            <img src="~/uploads/logo.png" style="
             width: 86px;
             max-width: 100%; border-radius: 5px;" />
        </a>

        //var userIdentities = User.Identities.Select(x => x.RoleClaimType).FirstOrDefault();
        //var test = User.Claims.Where(x=>x.Value == User.Identities.)
        //var cI = User.Identities.FirstOrDefault().RoleClaimType;
        var userRoles = User.Claims.Where(x => x.Type == User.Identities.Select(x => x.RoleClaimType).FirstOrDefault()).Select(c => c.Value);
        foreach (var role in userRoles)
        {
            if (role.ToLower().Equals("admin"))
            {
                <a class="nav-link text-dark" asp-area="" asp-controller="Subscriptions" asp-action="Create">New Subscription</a>

            }
        }
