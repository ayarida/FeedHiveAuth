@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager



<ul class="navbar-nav d-flex flex-row nav-left  mr-auto d-md-flex ">
	@if (SignInManager.IsSignedIn(User))
	{
		<li class="user-name">
			<a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">Hello @User.Identity?.Name!</a>
		</li>

		<form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
			<button type="submit" class="nav-link btn btn-link text-dark log-out">Logout</button>
		</form>

	}
	else
	{
		<a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Register">Register</a>
		<a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Login">Login</a>
		<a class="nav-link text-dark" asp-area="" asp-controller="Subscriptions" asp-action="Create">New Subscription</a>
	}
@{
    var x = SignInManager.UserManager;
}
<ul class="navbar-nav d-flex flex-row nav-left  mr-auto " >
    @if (SignInManager.IsSignedIn(User))
    {

        <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">Hello @User.Identity?.Name!</a>
        //var userIdentities = User.Identities.Select(x => x.RoleClaimType).FirstOrDefault();       
        //var test = User.Claims.Where(x=>x.Value == User.Identities.)
        //var cI = User.Identities.FirstOrDefault().RoleClaimType;
        var userRoles = User.Claims.Where(x => x.Type == User.Identities.Select(x => x.RoleClaimType).FirstOrDefault()).Select(c => c.Value);
        foreach (var role in userRoles)
        {
            if (role.ToLower().Equals("admin"))
            {
                <a class="nav-link text-dark" asp-area="" asp-controller="Subscriptions" asp-action="Create">New Subscription</a>

            }
        }
        <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" class="nav-link btn btn-link text-dark">Logout</button>
        </form>
        
    }
    else
    {
        <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Register">Register</a>
        <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Login">Login</a>
       
@*         <a class="nav-link text-dark" asp-area="" asp-controller="Subscriptions" asp-action="Create">New Subscription</a>
 *@    }
</ul>

<style>
	.log-out {
		background-color: red;
		color: white !important;
		width: fit-content;
	}

	.user-name {
		background-color: var(--green-color);
		padding: 10px;
		
	}

	.user-name a {
		color: white !important;
	}
</style>