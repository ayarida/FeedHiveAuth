@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@using FeedHiveAuth.Data.Helpers

@{
    var x = SignInManager.UserManager;
}
<ul class="navbar-nav d-flex flex-row nav-left greeting w-100 p-0">
    @if (SignInManager.IsSignedIn(User))
    {

        <form class="form-inline me-auto order-3" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <span style="border-radius: 50%;color: white !important;background: #728894;width: fit-content;padding: 8px 15px;"> @User.Identity?.Name!.Substring(0, 1).ToUpper()</span>
            <div class="dropdown">
                <div type="button" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-expanded="false" class="dropdown-toggle"></div>
                <ul class="dropdown-menu account" aria-labelledby="dropdownMenuButton">
                    <li class="dropdown-item text-center">@User.Identity?.Name</li>
                    <hr style="margin-top: 2px; margin-bottom: 3px;">
                    <a href="/Identity/Account/Manage"
                       class="list-group-item list-group-item-action py-2 text-center">
                        <i class="bi bi-person-circle"></i><span class="pe-2">@AppResources.Label("Account")</span>
                    </a>
                    <button type="submit" class="nav-link btn btn-link log-out" style="height: auto">@AppResources.Label("Logout")</button>
                </ul>
            </div>
        </form>


  
        var userRoles = User.Claims.Where(x => x.Type == User.Identities.Select(x => x.RoleClaimType).FirstOrDefault()).Select(c => c.Value);

    }
    else
    {
        <div class="register"><a class="nav-link text-dark register" asp-area="Identity" asp-page="/Account/Register">@AppResources.Label("Register")</a></div>
        <div class="login">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Login">@AppResources.Label("Login")</a>
        </div>
    }
</ul>

<style>
    .log-out {
        background-color: #d6081c !important;
        color: white !important;
        width: fit-content !important;
    }

        .log-out:hover {
            background-color: red;
        }

    .user-name {
        background-color: var(--green-color);
        padding: 10px;
    }

        .user-name a {
            color: white !important;
        }

    @@media (max-width: 992px) {
        .greeting {
            display: none !important;
        }
    }

    .register {
        margin: 1em;
        padding: 7px 20px;
        border: 0;
        border-radius: 25px;
        text-align: center;
        white-space: nowrap;
        cursor: pointer;
        font-size: 13px;
        background: black;
    }

    .login {
        padding: 7px 20px;
        border: 0;
        border-radius: 25px;
        text-align: center;
        white-space: nowrap;
        cursor: pointer;
        font-size: 13px;
    }

    .navbar-nav .nav-link {
        font-size: 17px;
        margin: 0;
    }

        .navbar-nav .nav-link.register {
            color: white !important;
        }

</style>