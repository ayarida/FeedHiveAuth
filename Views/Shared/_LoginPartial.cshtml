    </form> *@

    }
    else
    {
        <div class="register"><a class="nav-link text-dark register" asp-area="Identity" asp-page="/Account/Register">Register</a></div>
        <div class="login">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Login">Login</a>
        </div>
    }
</ul>

<style>
    .log-out {
        background-color: #ba0517;
        color: white !important;
        width: fit-content;
    }

        .log-out:hover {
            background-color: red;
        }

    .user-name {
        background-color: var(--green-color);
        padding: 10px;
    }

        .user-name a {
            color: white !important;
        }

    @@media (max-width: 992px) {
        .greeting {
            display: none !important;
        }
    }

    .register {
        margin: 1em;
        padding: 7px 20px;
        border: 0;
        border-radius: 25px;
        text-align: center;
        white-space: nowrap;
        cursor: pointer;
        font-size: 13px;
        background: black;
    }

    .login {
        padding: 7px 20px;
        border: 0;
        border-radius: 25px;
        text-align: center;
        white-space: nowrap;
        cursor: pointer;
        font-size: 13px;
    }

    .navbar-nav .nav-link {
        font-size: 17px;
        margin: 0;
    }

        .navbar-nav .nav-link.register {
            color: white !important;
        }

</style>