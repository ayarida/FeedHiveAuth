<!DOCTYPE html>
<html lang="en" dir="auto">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta property="og:title" content="Your Post Title" />
    <meta property="og:description" content="A brief description of your post." />
    <meta property="og:image" content="URL to the image" />
    <meta property="og:url" content="URL to the post" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Your Website Name" />

    <title>@(Convert.ToString(ViewData["Title"])) - FeedHiveAuth</title>


    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    @*     <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@200;300;400&family=IBM+Plex+Sans+Arabic&display=swap"
    rel="stylesheet" /> *@

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@200;300;400&family=IBM+Plex+Sans+Arabic&family=Noto+Sans+Arabic&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />


    <link rel="stylesheet" href="~/FeedHiveAuth.styles.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
          rel="stylesheet"
          integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN"
          crossorigin="anonymous" />

    <script src="https://cdn.tiny.cloud/1/fy30zx5b2vhaxpioybe1uc97bgi6xjnme7xphcko3q9ika1u/tinymce/7/tinymce.min.js" referrerpolicy="origin"></script>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"
            integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo="
            crossorigin="anonymous"></script>
    <link rel="stylesheet" href="~/css/Sidebar/core.css" />
    <link rel="stylesheet" href="~/css/Sidebar/navbar.css" />
    <script type="text/javascript" src="~/js/TableFilter/Filter.js"></script>
    <script type="text/javascript" src="~/js/Channels/channelsmodule.js"></script>
    <link rel="stylesheet" href="~/css/Filter.css" />
    <script type="text/javascript" src="~/js/Sidebar/mdb.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/Lib/axios.js"></script>

    <script src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            @if (TempData["SwalSuccess"] != null)
            {
                    <text>
                    Swal.fire({
                        icon: 'success',
                        title: 'Success',
                        text: '@TempData["SwalSuccess"]',
                        confirmButtonColor: '#3085d6'
                    });
                    </text>
            }

            @if (TempData["SwalError"] != null)
            {
                    <text>
                    Swal.fire({
                        icon: 'error',
                        title: 'Action blocked',
                        text: '@TempData["SwalError"]',
                        confirmButtonColor: '#d33'
                    });
                    </text>
            }

        });
    </script>
    <meta content="width=device-width, initial-scale=1" name="viewport" />

</head>
<body>
    @using FeedHiveAuth.Data.Helpers
    @inject SignInManager<ApplicationUser> SignInManager
    <header>
        @{
            var postslink = User.IsInRole("Master") ? "/Posts/Admins" : "/Posts/List";
        }
        @*Calling Sidebar*@
        @if (SignInManager.IsSignedIn(User))
        {
            <partial name="_LoginPartial" />

            <nav dir="auto" id="sidebarMenu"
                 class="collapse d-lg-block sidebar collapse bg-white" style="">
                <div class="position-sticky">
                    <div class="list-group list-group-flush mx-3">
                        <img src="~/Static/Images/logo.png" alt="logo" class="side-bar-logo" />

                        <a href="/Posts/Create" class="side-create">
                            <icon name="create" size="25"></icon>@AppResources.Label("CreatePost") <i class="bi bi-plus-lg"></i>
                        </a>

                        <div class="panel-link">
                            <a href="/Home/Index"
                               class="list-group-item list-group-item-action"
                               aria-current="true">
                                <icon name="home" size="25"></icon>
                                <span>@AppResources.Label("Dashboard")</span>
                            </a>
                        </div>

                        <a href="/Posts/Create"
                           class="list-group-item list-group-item-action py-2"
                           aria-current="true">
                            <icon name="create" size="25"></icon><span>@AppResources.Label("CreatePost")</span>
                        </a>
                        <a href="@postslink"
                           class="list-group-item list-group-item-action py-2 ">
                            <icon name="posts" size="27"></icon> <span>@AppResources.Label("Posts")</span>
                        </a>
                        <a href="/Social/Channels/Create"
                           class="list-group-item list-group-item-action py-2 ">
                            <icon name="platforms" size="25"></icon><span>@AppResources.Label("SocialMedia")</span>
                        </a>
                        <a href="/MediaItem/List"
                           class="list-group-item list-group-item-action py-2 ">
                            <icon name="media" size="25"></icon><span>@AppResources.Label("Media")</span>
                        </a>
                        <a href="/Users/ListTree"
                           class="list-group-item list-group-item-action py-2 ">
                            <icon name="team" size="25"></icon><span>@AppResources.Label("Team")</span>
                        </a>

                        <a href="/Social/channels/Index" class="list-group-item list-group-item-action py-2 ">
                            <icon name="channels" size="25"></icon><span>@AppResources.Label("Channels")</span>
                        </a>

                        <a href="/Roles/Index" class="list-group-item list-group-item-action py-2 ">
                            <icon name="posts" size="27"></icon><span>@AppResources.Label("Roles")</span>
                        </a>
                    </div>

                    <div class="list-group list-group-flush mx-3 bottom-list">
                        <hr />
                        <a href="/Resources/Index"
                           class="list-group-item list-group-item-action py-2 "
                           aria-current="true">
                            <icon name="translate" size="25"></icon><span>@AppResources.Label("Dictionary")</span>
                        </a>

                        <a href="/Configs/SocialConfigs"
                           class="list-group-item list-group-item-action py-2 "
                           aria-current="true">
                            <icon name="settings" size="23"></icon><span>@AppResources.Label("Settings")</span>
                        </a>
                        <a href="/Identity/Account/Manage"
                           class="list-group-item list-group-item-action py-2 ">
                            <icon name="account" size="20"></icon><span>@AppResources.Label("Account")</span>
                        </a>
                    </div>
                </div>
            </nav>
        }




        @*Calling navbar*@

    </header>
    <div class="container">
        <div class="container">
            <main role="main" class="pb-3" dir="auto">
                @RenderBody()
            </main>
        </div>
    </div>
    <div id="global-loader" class="loader-overlay" style="display: none;">
        <div class="spinner"></div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL"
            crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", false)


    <script>

        //Highlight current sidebar menu link

        $("#sidebarMenu a").each(function (i) {
            if (window.location.href.includes($(this).attr('href'))) {
                $(this).addClass("active")
            }
        })

        // if (window.location.pathname != '/') {
        //     $("body").css("background-color", "#f6f9fc")
        // }

    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const loader = document.getElementById('global-loader');

            // Function to show loader
            window.showGlobalSpinner = function() {
                loader.style.display = 'flex';
            };

            // Function to hide loader
            window.hideGlobalSpinner = function() {
                loader.style.display = 'none';
            };

            // 1. Intercept Link Clicks
            document.addEventListener('click', function(e) {
                // Find closest anchor tag (in case user clicks an icon inside an a tag)
                const link = e.target.closest('a');

                // Logic to decide if we should show the spinner
                if (link && link.href) {
                    const href = link.getAttribute('href');
                    const target = link.getAttribute('target');

                    // IGNORE:
                    // 1. Links with '#' or 'javascript:'
                    // 2. Links opening in new tab (_blank)
                    // 3. Links with specific 'onclick' events (like your delete button) 
                    //    unless you manually want to trigger it there.
                    if (
                        href.startsWith('#') ||
                        href.startsWith('javascript:') ||
                        target === '_blank' ||
                        link.hasAttribute('onclick') || // We let your custom scripts handle this
                        e.ctrlKey || // Ctrl+Click (new tab)
                        e.metaKey    // Cmd+Click (Mac new tab)
                    ) {
                        return;
                    }

                    // If it passes checks, show spinner
                    showGlobalSpinner();
                }
            },true);

            // 2. Intercept Form Submissions
            document.addEventListener('submit', function(e) {
                // Only show if the form is valid (if you use validation)
                if (!e.target.checkValidity || e.target.checkValidity()) {
                    showGlobalSpinner();
                }
            });

            // 3. Fix "Back Button" Issue
            // If user clicks Back, the page is loaded from cache and spinner might still be there.
            // This hides it when the page is restored.
            window.addEventListener('pageshow', function(event) {
                if (event.persisted) {
                    hideGlobalSpinner();
                }
            });
            
        });

    </script>
    
    </body>
</html>