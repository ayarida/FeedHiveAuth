<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FeedHiveAuth</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@200;300;400&family=IBM+Plex+Sans+Arabic&display=swap"
          rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/FeedHiveAuth.styles.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
          rel="stylesheet"
          integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN"
          crossorigin="anonymous" />

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL"
            crossorigin="anonymous"></script>
    
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"
            integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo="
            crossorigin="anonymous"></script>

    <link rel="stylesheet" href="~/css/Sidebar/core.css" />
 
    <script type="text/javascript" src="~/js/Sidebar/mdb.js"></script>
    <link rel="stylesheet" href="~/css/Sidebar/navbar.css" />
    @* <script type="text/javascript" src="~/js/Editor/jquery.richtext.min.js"></script> *@
    <link rel="stylesheet" href="~/css/Editor/richtext.min.css" />
</head>
<body>

    <div class="container">
        <header>

            @*Calling Sidebar*@
            <nav id="sidebarMenu"
                 class="collapse d-lg-block sidebar collapse bg-white">
                <div class="position-sticky">
                    <div class="list-group list-group-flush mx-3 mt-4">
                        <a href="/Posts/Create"
                           class="list-group-item list-group-item-action py-2 ripple active"
                           aria-current="true">
                            <i class="bi bi-pencil-square"></i><span>إنشاء المحتوى</span>
                        </a>
                        <a href="#"
                           class="list-group-item list-group-item-action py-2 ripple">
                            <i class="bi bi-calendar"></i><span>الجدول المحتوى</span>
                        </a>
                        <a href="#"
                           class="list-group-item list-group-item-action py-2 ripple"><i class="bi bi-grid"></i><span>المنشورات</span></a>
                        <a href="#"
                           class="list-group-item list-group-item-action py-2 ripple">
                            <i class="bi bi-building-gear"></i><span>التواصل الاجتماعي</span>
                        </a>
                        <a href="/MediaItem/Upload"
                           class="list-group-item list-group-item-action py-2 ripple">
                            <i class="bi bi-collection-fill"></i><span>الميديا</span>
                        </a>
                        <a href="#"
                           class="list-group-item list-group-item-action py-2 ripple">
                            <i class="bi bi-microsoft-teams"></i><span>الفريق</span>
                        </a>
                    </div>

                    <div class="list-group list-group-flush mx-3 bottom-list">
                        <a href="#"
                           class="list-group-item list-group-item-action py-2 ripple"
                           aria-current="true">
                            <i class="bi bi-gear"></i><span>الاعدادات</span>
                        </a>
                        <a href="#"
                           class="list-group-item list-group-item-action py-2 ripple">
                            <i class="bi bi-person-raised-hand"></i><span>دعم</span>
                        </a>
                    </div>
                </div>
            </nav>

            <nav id="main-navbar"
                 class="navbar navbar-expand-lg navbar-light bg-white fixed-top">
                <!-- Container wrapper -->
                <div class="container-fluid">
                    <!-- Toggle button -->
                    <button class="navbar-toggler"
                            type="button"
                            data-mdb-toggle="collapse"
                            data-mdb-target="#sidebarMenu"
                            aria-controls="sidebarMenu"
                            aria-expanded="false"
                            aria-label="Toggle navigation">
                        <i class="bi bi-list"></i>
                    </button>
                    <partial name="_LoginPartial" />
                    </div>
            </nav>

            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">FeedHiveAuth</a>
            @*   <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
            aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
            </button> *@

            @*Calling navbar*@

        </header>
        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    </div>

@*     <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2023 - FeedHiveAuth - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer> *@
    <script type="text/javascript" src="~/js/site.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    @* <script type="text/javascript" src="~/js/Editor/jquery.richtext.min.js"></script> *@
    @* <script> *@
    @*     $(document).ready(function () { *@
    @*         $(".content").richText(); *@
    @*     }); *@
    @* </script> *@
</body>
</html>
