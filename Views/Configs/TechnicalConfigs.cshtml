@model FeedHiveAuth.Areas.Social.Models.SocialConfigs

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var configs = Model;
    var fbConfigs = configs.FacebookConfigs;
    var telegramConfigs = configs.TelegramConfigs;
    var twitterConfigs = configs.TwitterConfigs;
    var instagramConfigs = configs.InstagramConfigs;
    var wpConfigs = configs.WhatsappConfigs;
}


<div class="py-4" id="configsList">

    <div id="facebookConfigs" class="mt-3">
        <h6 class="config-title mb-5">Facebook Configs</h6>
        <div class="config-settings ps-md-5">
            <div class="setting-instance">
                <label for="facebook-name">Display Name</label>
                <input type="text" id="facebook-name" name="data.name">
            </div>

            <div class="setting-instance">
                <label for="facebook-id">App ID</label>
                <input type="text" id="facebook-id" name="data.id" />
            </div>

            <div class="setting-instance">
                <label for="facebook-id">App Secrete</label>
                <input type="text" id="facebook-id" name="data.secret" />
            </div>


            <div class="setting-instance enable-setting">
                <label for="facebook-status">Enabled</label>
                <label class="switch">
                    <input type="checkbox" id="facebook-status" name="data.status">
                    <span class="slider round"></span>
                </label>
            </div>

        </div>
    </div>

    <div id="twitterConfigs" class="mt-5">
        <h6 class="config-title mb-5">twitter Configs</h6>
        <div class="config-settings ps-md-5">
            <div class="setting-instance">
                <label for="twitter-name">Display Name</label>
                <input type="text" id="twitter-name" name="data.name" />
            </div>

            <div class="setting-instance">
                <label for="twitter-id">App ID</label>
                <input type="text" id="twitter-id" name="data.id" />
            </div>


            <div class="setting-instance enable-setting">
                <label for="twitter-status">Enabled</label>
                <label class="switch">
                    <input type="checkbox" id="twitter-status" name="data.enabled">
                    <span class="slider round"></span>
                </label>
            </div>



        </div>
    </div>


    <div id="telegramConfigs" class="mt-5">
        <p>@fbConfigs.Application.Enabled</p>
        <h6 class="config-title mb-5">telegram Configs</h6>
        <div class="config-settings ps-md-5">
            <div class="setting-instance">
                <label for="telegram-name">User Name</label>
                <input type="text" id="telegram-name" name="data.name" />
            </div>

            <div class="setting-instance">
                <label for="telegram-id">Token</label>
                <input type="text" id="telegram-id" name="data.token" />
            </div>


            <div class="setting-instance enable-setting">
                <label for="telegram-status">Enabled</label>
                <label class="switch">
                    <input type="checkbox" id="telegram-status" name="data.enabled">
                    <span class="slider round"></span>
                </label>
            </div>



        </div>
    </div>


    <div id="instagramConfigs" class="mt-5">
        <h6 class="config-title mb-5">instagram Configs</h6>
        <div class="config-settings ps-md-5">
            <div class="setting-instance">
                <label for="instagram-name">Display Name</label>
                <input type="text" id="instagram-name" name="data.name" />
            </div>

            <div class="setting-instance">
                <label for="instagram-id">App ID</label>
                <input type="text" id="instagram-id" name="data.id" />
            </div>


            <div class="setting-instance enable-setting">
                <label for="instagram-status">Enabled</label>
                <label class="switch">
                    <input type="checkbox" id="instagram-status" name="data.enabled">
                    <span class="slider round"></span>
                </label>
            </div>



        </div>
    </div>


    <div id="whatsappConfigs" class="mt-5">
        <h6 class="config-title mb-5">whatsapp Configs</h6>
        <div class="config-settings ps-md-5">
            <div class="setting-instance">
                <label for="whatsapp-name">Display Name</label>
                <input type="text" id="whatsapp-name" name="data.name" />
            </div>

            <div class="setting-instance">
                <label for="whatsapp-id">App ID</label>
                <input type="text" id="whatsapp-id" name="data.id" />
            </div>


            <div class="setting-instance enable-setting">
                <label for="whatsapp-status">Enabled</label>
                <label class="switch">
                    <input type="checkbox" id="whatsapp-status" name="data.enabled">
                    <span class="slider round"></span>
                </label>
            </div>



        </div>
    </div>

    <button id="saveData" class="mt-5">Save Changes</button>




</div>
<script type="text/javascript" src="~/js/JsonForm/JsonForm.js"></script>

