<style>

    input[type=text] {
        border: 1px solid #212c37 !important;
        border-radius: 3px !important;
        padding: 0.375rem 0.75rem;
    }

    #configsList {
        display: flex;
        flex-direction: column;
        background: white;
        padding-left: 32px;
    }

    .setting-instance label:not(.switch) {
        width: 7rem;
        color: var(--blue-color);
    }

    .config-title {
        color: var(--blue-color);
        font-weight: bold;
        text-align: left;
    }

    .config-settings {
        padding-left: 10px;
        display: flex;
        flex-direction: column;
        row-gap: 20px;
        justify-content: flex-end;
        align-items: self-end;
    }

        .config-settings input {
            /* border-radius: 5px; */
            text-align: left;
            direction: ltr;
        }

    .setting-instance {
        display: flex;
        column-gap: 10px;
        flex-direction: row-reverse;
        padding-right: 35px;
        width: 100%;
        align-items: center;
    }

    .enable-setting {
        align-items: center;
    }

    /* Toggle Style */
    .switch {
        position: relative;
        display: inline-block;
        width: 60px;
        height: 34px;
    }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #ccc;
        -webkit-transition: .4s;
        transition: .4s;
    }

        .slider:before {
            position: absolute;
            content: "";
            height: 26px;
            width: 26px;
            left: 4px;
            bottom: 4px;
            background-color: white;
            -webkit-transition: .4s;
            transition: .4s;
        }

    input:checked + .slider {
        background-color: #2196F3;
    }

    input:focus + .slider {
        box-shadow: 0 0 1px #2196F3;
    }

    input:checked + .slider:before {
        -webkit-transform: translateX(26px);
        -ms-transform: translateX(26px);
        transform: translateX(26px);
    }

    /* Rounded sliders */
    .slider.round {
        border-radius: 34px;
    }

        .slider.round:before {
            border-radius: 50%;
        }

    .setting-instance input {
        width: 100%;
    }

    label {
        text-wrap: nowrap;
        text-align: left;
    }
</style>