@model IEnumerable<FeedHiveAuth.Models.MediaItem>
@using FeedHiveAuth.Data.Helpers;
@using FeedHiveAuth.Data;
@using FeedHiveAuth.Models.Enums
@using FeedHiveAuth.Data.Extensions


@{
    ViewData["Title"] = "View";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var _mediaService = Instances.Repositories.MediaItemRepository;
}

<div class="card">

    <div class="card-header" style="background: #F6F9FC !important">
        <h3>@AppResources.Label("MediaList","ar")</h3>
    </div>
    <p class="mt-4 mb-4 pe-3">
        <a asp-action="Create" style="background-color:rgb(13, 110, 253); color: white; border-radius: 5px;
padding: 6px;">@AppResources.Label("AddMedia","ar") +</a>
    </p>
    <div class="d-flex flex-row flex-wrap media-list p-3">

        @foreach (var item in Model)
        {

            <div class="media-item">
                <img src="@item.Path" style="width: 200px;height: 132px; max-width: 100%; max-height: 100%" />

                @if (item.Type == 20)
                {

                }

                <div class="media-details">
                    <div class="p-3 caption">
                        <p style="word-break: break-all;white-space: normal">@item.Caption</p>
                    </div>
                    <div class="delete d-flex p-3">
                        <button onclick="deleteMedia(this.id)" id="@item.Id">
                            @AppResources.Label("Delete","ar")
                            <i class="bi bi-trash3-fill"></i>
                        </button>

                    </div>
                </div>
            </div>
        }

    </div>

</div>


<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    function deleteMedia(event) {

        swal.fire({
            customClass: {
                confirmButton: "btn btn-success",
            },
            title: @AppResources.Label("SureDeleteMedia"),
            text: @AppResources.Label("CannotUndo"),
            icon: "warning",
            buttons: true,
            dangerMode: true,
            // buttons: ["كلّا", "نعم"],
            confirmButtonText: @AppResources.Label("Yes"),
            cancelButtonText: @AppResources.Label("No"),
            showCancelButton: true,
            showConfirmButton: true,
            className: {
                text: 'pleaseWork',
            },
        })
            .then((willDelete) => {
                if (willDelete.isConfirmed) {

                    var serviceURL = "/MediaItem/DeleteMediaItem/" + event;
                    var mediaId = event;
                    $.ajax({
                        type: "DELETE",
                        url: serviceURL,
                        data: mediaId,
                        success: function (data) {
                            swal.fire({
                                title: @AppResources.Label("DeletedSuccesfully"),
                                text: @AppResources.Label("MediaDeleted"),
                                icon: "success"
                            }).then(function () {
                                window.location.reload();
                            }
                            )
                        },
                        error: function (data) {
                            swal.fire(@AppResources.Label("DeleteError"), @AppResources.Label("PlzTryagain"), "error");
                        },
                    })

                } else {
                    swal.fire({
                        title: @AppResources.Label("DeleteCanceled"),
                        confirmButtonText: @AppResources.Label("Confirm")
                    });
                }
            });

    }
</script>

<link rel="stylesheet" href="~/css/MediaItems/List.css" />