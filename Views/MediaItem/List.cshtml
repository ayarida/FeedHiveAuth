@model IEnumerable<FeedHiveAuth.Models.MediaItem>
@using FeedHiveAuth.Data;
@using FeedHiveAuth.Models.Enums
@using FeedHiveAuth.Data.Extensions


@{
    ViewData["Title"] = "View";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var _mediaService = Instances.Repositories.MediaItemRepository;
}

<div class="card p-3">
    <h1>قائمة الميديا</h1>
    <p class="mt-3 mb-4">
        <a asp-action="Create" style="background-color:rgb(13, 110, 253); color: white; border-radius: 5px;
padding: 6px;">إضافة ميديا +</a>
    </p>


    <div class="d-flex flex-row flex-wrap media-list">

        @foreach (var item in Model)
        {

            <div class="media-item">
                <img src="@item.Path" style="width: 200px;height: 132px; max-width: 100%; max-height: 100%" />

                @if (item.Type == 20)
                {

                }

                <div class="media-details">
                    <div class="p-3 caption">
                        <p style="word-break: break-all;white-space: normal">@item.Caption</p>
                    </div>
                    <div class="delete d-flex p-3">
                        <button onclick="deleteMedia(this.id)" id="@item.Id">
                            حذف
                            <i class="bi bi-trash3-fill"></i>
                        </button>

                    </div>
                </div>
            </div>
        }

    </div>

</div>


<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    .media-list {
        column-gap: 10px;
        row-gap: 20px;
    }

    @@media (max-width: 452px) {
        .media-list {
            justify-content: center;
        }
    }

    .media-list img {
        border-top-right-radius: 5px;
        border-top-left-radius: 5px;
    }

    .media-details {
        border: 1px solid black;
        width: 200px;
        max-width: 100%;
        border-bottom-right-radius: 5px;
        border-bottom-left-radius: 5px;
        overflow: auto;
    }

    button {
        width: 100%;
        background-color: #a5a5a5;
    }

    .delete {
        background-color: #f8f7fd;
        border-top: 1px solid #d0d0d5;
    }

        .delete button {
            color: red;
            width: fit-content;
            background: transparent;
            height: fit-content;
            border: none;
            box-shadow: none;
            padding: 0 !important;
        }



        .delete i::before {
            display: table-cell;
            vertical-align: middle;
            text-align: center;
        }

    a {
        text-decoration: none;
    }

    .caption {
        background-color: white;
    }
</style>

<script>
    function deleteMedia(event) {

        swal.fire({
            customClass: {
                confirmButton: "btn btn-success",
            },
            title: "هل أنت متأكد من رغبتك في حذف الوسائط؟ ",
            text: "لا يمكن التراجع عن هذا الإجراء",
            icon: "warning",
            buttons: true,
            dangerMode: true,
            // buttons: ["كلّا", "نعم"],
            confirmButtonText: "نعم",
            cancelButtonText: "لا",
            showCancelButton: true,
            showConfirmButton: true,
            className: {
                text: 'pleaseWork',
            },
        })
            .then((willDelete) => {
                if (willDelete.isConfirmed) {

                    var serviceURL = "/MediaItem/DeleteMediaItem/" + event;
                    var mediaId = event;
                    $.ajax({
                        type: "DELETE",
                        url: serviceURL,
                        data: mediaId,
                        success: function (data) {
                            swal.fire({
                                title: "تم الحذف",
                                text: "تم حذف الميديا",
                                icon: "success"
                            }).then(function () {
                                window.location.reload();
                            }
                            )
                        },
                        error: function (data) {
                            swal.fire("خطأ في الحذف!", "الرجاء المحاولة مرة أخرى", "error");
                        },
                    })

                } else {
                    swal.fire({
                        title: "تم إلغاء محاولة الحذف",
                        confirmButtonText: "موافق"
                    });
                }
            });

    }
</script>