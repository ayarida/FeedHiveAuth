                    </div>
                </div>
                <div class="card-body">
                    @*                     <h1>0 أيام</h1>
                    *@                    <h1>@Model.userPostsCount منشورات</h1>
                    <a href="/Posts/Create">
                        <button type="button" class="btn green-btn">
