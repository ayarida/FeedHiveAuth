@using FeedHiveAuth.Models.ViewModels;
@using FeedHiveAuth.Services;
@using Microsoft.AspNetCore.Identity
@using FeedHiveAuth.Data.Helpers;
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@model UserDataViewModel

@{
    ViewData["Title"] = "Home Page";
    var data = Model;
    // var currUser = GlobalContext.UserConfigs?.UserData;
    var signedIn = SignInManager.IsSignedIn(User);
    // IWebHostEnvironment _hostingEnvironment;
    // var filePath = System.IO.Path.Combine("wwwroot", "uploads", "test.jpg");
    // var photoStream = new FileStream(filePath,FileMode.Open,FileAccess.Read);
    IWebHostEnvironment _hostingEnvironment;
    // var filePath = System.IO.Path.Combine("wwwroot", "uploads", "test.jpg");
    // var photoStream = new FileStream(filePath, FileMode.Open, FileAccess.Read);
    var posts = Model.allPosts;
    var userPosts = Model.userPosts;
}


<div class="container pt-4" dir="rtl">

    @*user greeting*@
    <div class="row user">
        <div class="greeting my-4">
            <div class="user-greet d-flex justify-content-between align-items-baseline" style="width: 100%">
                @if (signedIn)
                {
                    <div>
                        <h2>@AppResources.Label("Hello", "ar") @User.Identity.Name @AppResources.Label("takealook", "ar") </h2>
                    </div>
                }
            </div>
        </div>
    </div>

    @*card status*@
    <div class="row row-cols-1 row-cols-md-2mb-3">
        <div class="col-lg-6">
            <div class="card status-cards">
                <h2>@Model.userTotalTodayCount </h2>
                <div class="vertical-separator"></div>
                <h2>@AppResources.Label("todaysposts", "ar")</h2>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card status-cards">
                <h2>@Model.userTotalTodayCount</h2>
                <div class="vertical-separator"></div>
                <h2>@AppResources.Label("totalposts", "ar")</h2>
            </div>
        </div>
        <div class="col-lg-12 mt-5">
            <a href="/Posts/Create" class="side-create">
                <icon name="create" size="25"></icon>@AppResources.Label("CreatePost") <i class="bi bi-plus-lg"></i>
            </a>
        </div>
    </div>

    @*recent posts*@
    <div class="row gy-3 mt-5">
        <h2>@AppResources.Label("Archive", "ar")</h2>
        @foreach (var post in userPosts.Take(10))
        {
            <div class="col-md-3">
                <div class="card p-3 archive-card">
                    <div class="archive-card-header">
                        <h5> @post.Title</h5>
                        <div class="d-flex justify-content-between flex-row-reverse align-items-center">
                            <div class="archive_menu">
                                <i class="bi bi-three-dots-vertical"></i>
                                <ul class="archive_operations">
                                    <li>@Html.ActionLink(AppResources.Label("Update", "ar"), "Edit", "Posts", new { @post.Id })</li>
                                    <li><a href="/Social/Publish/Share?postid=@post.Id">@AppResources.Label("Share", "ar")</a></li>
                                    <li><a onclick="deletePost(this.id)" id="@post.Id">@AppResources.Label("Delete", "ar")</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <p class="content">@post.Content</p>
                    <div class="post-metas"><span>@post.CreatedByName</span><span>@post.PostDate</span></div>
                </div>
            </div>
        }
    </div>


    @await Html.PartialAsync("~/Views/Shared/_shareFromArchive.cshtml", data)

</div>


<script>
    var quickPostTitle = '@AppResources.Label("FillAllRequiredFields", "ar")';
</script>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
<link rel="stylesheet" href="~/css/Index/index.css" />
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script src="~/js/Index/index.js"></script>
<script src="~/js/Posts/quickpost.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", function() {

        // 1. Select all archive menu containers
        const archiveMenus = document.querySelectorAll('.archive_menu');

        // 2. Add click event to each menu
        archiveMenus.forEach(menu => {
            menu.addEventListener('click', function(e) {
                e.stopPropagation(); // Prevent the click from bubbling to the document

                // Optional: Close all other open menus first
                archiveMenus.forEach(otherMenu => {
                    if (otherMenu !== menu) {
                        otherMenu.classList.remove('active');
                    }
                });

                // Toggle the 'active' class on the clicked menu
                this.classList.toggle('active');
            });
        });

        // 3. Close menu when clicking anywhere else on the document
        document.addEventListener('click', function() {
            archiveMenus.forEach(menu => {
                menu.classList.remove('active');
            });
        });
    });
</script>