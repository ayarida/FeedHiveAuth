                            يمكن أن تكون لذيذة ومرضية. من خلال إجراء تغييرات صغيرة في
                        </p>
                    </div>
                </div>
                <div class="swiper2">
                    <div class="swiper-wrapper">
                        @foreach (var post in posts.Take(10))
                        {
                            <div class="swiper-slide">
