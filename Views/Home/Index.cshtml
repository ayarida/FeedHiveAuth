                <div class="card-head">
                    <div class="card-icon">
                        <img src="~/Static/Icons/Group35.png" />
                    </div>
                    <div class="card-text">
                        <h1>مساء الخير، إيمان</h1>
                        <h2>لديك منشورات جديدة</h2>
                    </div>
                </div>
                <div class="card-body">
