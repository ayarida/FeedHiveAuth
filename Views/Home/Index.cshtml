@using FeedHiveAuth.Models.ViewModels;
@using FeedHiveAuth.Services;
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@model UserDataViewModel

@{
    ViewData["Title"] = "Home Page";
    var data = Model;
    // var currUser = GlobalContext.UserConfigs?.UserData;
    var signedIn = SignInManager.IsSignedIn(User);
    // IWebHostEnvironment _hostingEnvironment;
    // var filePath = System.IO.Path.Combine("wwwroot", "uploads", "test.jpg");
    // var photoStream = new FileStream(filePath,FileMode.Open,FileAccess.Read);
    IWebHostEnvironment _hostingEnvironment;
    // var filePath = System.IO.Path.Combine("wwwroot", "uploads", "test.jpg");
    // var photoStream = new FileStream(filePath, FileMode.Open, FileAccess.Read);
    List<Post> posts = Model.allPosts;

}


<div class="container pt-4" dir="rtl">
    <div class="row user">
        <div class="greeting my-4">
            <div class="user-greet">
                @if (signedIn)
                {
                    <h2>  مساء الخير @User.Identity.Name </h2>
                    <p>مرحبا بك، ألقي نظرة على نشاطاتك</p>
                }
            </div>
            @*             <a href="/Posts/Create">
            <button class="btn purple-btn">
            أنشر المنشور الحالي
            <i class="bi bi-plus-lg"></i>
            </button>
            </a> *@
        </div>
    </div>

    <div class="row p-2 row row-cols-1 row-cols-md-2 g-4 mb-3">
        <!-- Normal Card -->
        <div class="col-lg-6 no-slide">
            <div class="card p-4">
                <div class="card-head">
                    <div class="card-icon">
                        <img src="~/Static/Icons/Group35.png" />
                    </div>
                    <div class="card-text">
                        <h1>جدول المنشورات</h1>
                        <h2>لديك منشورات جديدة</h2>
                    </div>
                </div>
                <div class="card-body">
                    @*                     <h1>0 أيام</h1>
                    *@                    <h1>@Model.userPostsCount منشورات</h1>
                    <a href="/Posts/Create">
                        <button type="button" class="btn green-btn">
                            أنشئ منشور

                            <i class="bi bi-plus-lg"></i>
                        </button>
                    </a>
                </div>
            </div>
        </div>
        <div class="col-lg-6 no-slide">
            <div class="card p-4">
                <div class="card-head">
                    <div class="card-icon">
                        <img src="~/Static/Icons/Group35.png" />
                    </div>
                    <div class="card-text">
                        <h1>جدول المنشورات</h1>
                        <h2>لديك منشورات جديدة</h2>
                    </div>
                </div>
                <div class="card-body">
                    <h1>0 أيام</h1>
                    <a href="/Posts/Create">
                        <button type="button" class="btn green-btn">
                            أنشئ منشور

                            <i class="bi bi-plus-lg"></i>
                        </button>
                    </a>
                </div>
            </div>
        </div>
        <!-- Card with button slider -->
        <div class="col-lg-6">
            <div class="card p-4">
                <div class="card-head">
                    <div class="card-icon">
                        <img src="~/Static/Icons/Group35.png" />
                    </div>
                    <div class="card-text">
                        <h1>————</h1>
                        <h2>
                            اختر نموذج تم إنشاؤه بواسطة الذكاء الاصطناعي لتبدء منه.
                        </h2>
                    </div>
                </div>

                <div class="card-body">
                    <div class="stroke-div mb-0">
                        <button type="button" class="btn grey-btn p-2 my-3">
                            اللياقة والصحة
                        </button>
                        <p class="stroke-text">
                            الأكل الصحي لا يجب أن يكون مملاً أو لا طعم له! في الواقع،
                            يمكن أن تكون لذيذة ومرضية. من خلال إجراء تغييرات صغيرة في
                        </p>
                    </div>
                </div>
                <div class="swiper2">
                    <div class="swiper-wrapper">
                        @foreach (var post in posts.Take(10))
                        {
                            <div class="swiper-slide">
                                placeholder
                            </div>
                        }
                    </div>
                    <div class="swiper-button-prev"></div>
                    <div class="swiper-button-next"></div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card p-4">
                <div class="card-head">
                    <div class="card-icon">
                        <img src="~/Static/Icons/Group35.png" />
                    </div>
                    <div class="card-text">
                        <h1>————</h1>
                        <h2>
                            اختر نموذج تم إنشاؤه بواسطة الذكاء الاصطناعي لتبدء منه.
                        </h2>
                    </div>
                </div>

                <div class="card-body">
                    <div class="stroke-div mb-0">
                        <button type="button" class="btn grey-btn p-2 my-3">
                            اللياقة والصحة
                        </button>
                        <p class="stroke-text">
                            الأكل الصحي لا يجب أن يكون مملاً أو لا طعم له! في الواقع،
                            يمكن أن تكون لذيذة ومرضية. من خلال إجراء تغييرات صغيرة في
                        </p>
                    </div>
                </div>
                <div class="swiper2">
                    <div class="swiper-wrapper">
                        @foreach (var post in posts.Take(10))
                        {
                            <div class="swiper-slide">
                                placeholder
                            </div>
                        }
                    </div>
                    <div class="swiper-button-prev"></div>
                    <div class="swiper-button-next"></div>
                </div>
            </div>
        </div>
    </div>


    <div class="row">
        <p style="font-weight: bold ; font-size: 20px">الأرشيف</p>
        <p style="color: #a2aebc">إختر اقتراحا أدناه و قم بجدولة عرضه مرة أخرى</p>
        <div class="d-flex flex-row-reverse justify-content-around flex-sm-wrap">
            @foreach (var post in posts.Take(4))
            {
                <div class="card p-3 justify-content-between rounded-3" style="width: 240px">
                    <div class="d-flex justify-content-between align-items-center mb-3 flex-row-reverse" style="font-size: 13px; color: #b3c1d3">
                        <span style="direction: ltr">
                            @post.PostDate
                        </span>
                        <div class="d-flex align-items-center" style="column-gap: 3px"><i class="bi bi-images"></i>@(post.PostMediaItems != null ? "1" : "0")</div>
                    </div>
                    <p> @post.Title</p>
                    <p class="content" style="height: 75px !important; white-space: nowrap;overflow: hidden;text-overflow: ellipsis;">@post.Content</p>
                    <div class="d-flex justify-content-between flex-row-reverse align-items-center">
                        <span style="background-color: #728894; color: white; border-radius: 50%; width: 20px; font-size:13px; display: block; text-align: center">@User.Identity?.Name!.Substring(0, 1).ToUpper()</span>


                        <div class="archive_menu">
                            <i class="bi bi-three-dots-vertical"></i>
                            <ul class="archive_operations">
                                <li>@Html.ActionLink("تعديل", "Edit", "Posts", new { @post.Id })</li>
                                <li><a href="/Social/Publish/Share?postid=@post.Id">المشاركة</a></li>
                                <li><a onclick="deletePost(this.id)" id="@post.Id">حذف</a></li>
                            </ul>
                        </div>

                    </div>

                </div>
            }

        </div>

    </div>




    @await Html.PartialAsync("~/Views/Shared/_shareFromArchive.cshtml", data)
</div>

<style>
    a {
        text-decoration: none;
    }

    .swiper-slide {
        box-shadow: rgba(99, 99, 99, 0.2) 0px 2px 8px 0px;
        padding: 15px;
    }

    .post-list span {
        font-weight: bold;
    }

    .post-list a {
        font-weight: bold;
    }

    .swiper2 {
        position: relative;
        overflow: hidden;
        text-align: center;
    }


    @@media(max-width: 480px) {
        .swiper-slide {
            padding: 25px;
        }
    }

</style>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script src="~/js/Index/index.js"></script>