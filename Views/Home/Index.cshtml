@using FeedHiveAuth.Models.ViewModels;
@using FeedHiveAuth.Services;
@using Microsoft.AspNetCore.Identity
@using FeedHiveAuth.Data.Helpers;
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@model UserDataViewModel

@{
    ViewData["Title"] = "Home Page";
    var data = Model;
    var signedIn = SignInManager.IsSignedIn(User);
    var posts = Model.allPosts;
    var userPosts = Model.userPosts;
}


<div class="container pt-4" dir="rtl">
    <div class="row user">
        <div class="greeting my-4">
            <div class="user-greet d-flex justify-content-between align-items-baseline" style="width: 100%">
                @if (signedIn)
                {
                    <div>
                        <h2>  @AppResources.Label("Hello","ar") @User.Identity.Name </h2>
                        <p>@AppResources.Label("WelcomeMsg","ar")</p>
                    </div>
                    <div>


                        <a href="/Posts/Create" style="color: white; width: 255px;" class="d-flex w-100 h-100 align-items-center justify-content-center btn btn-primary p-3">
                            @AppResources.Label("CreateYourNewPost","ar") <i class="bi bi-plus-lg pe-2"></i>
                        </a>

                    </div>
                }
            </div>
        </div>
    </div>

    <div class="row p-2 row row-cols-1 row-cols-md-2 g-4 mb-3">
        <!-- Normal Card -->
        <div class="col-lg-6 no-slide">
            <div class="card p-4">
                <div class="card-head">
                    <div class="card-icon">
                        <img src="~/Static/Icons/Group35.png" />
                    </div>
                    <div class="card-text">
                        <h1>@AppResources.Label("PostsSchedule","ar")</h1>
                        <h2>لديك منشورات جديدة</h2>
                    </div>
                </div>
                <div class="card-body">
                    @*                     <h1>0 أيام</h1>
                    *@                    <h1>@Model.userPostsCount @AppResources.Label("Posts","ar")
                    </h1>
                    <a href="/Posts/Create">
                        <button type="button" class="btn green-btn">
                            @AppResources.Label("CreatePost","ar")

                            <i class="bi bi-plus-lg"></i>
                        </button>
                    </a>
                </div>
            </div>
        </div>
        <div class="col-lg-6 no-slide">
            <div class="card p-4">
                <div class="card-head">
                    <div class="card-icon">
                        <img src="~/Static/Icons/Group35.png" />
                    </div>
                    <div class="card-text">
                        <h1>@AppResources.Label("PostsSchedule","ar")</h1>
                        <h2>@AppResources.Label("YouHaveNewPosts","ar")</h2>
                    </div>
                </div>
                <div class="card-body">
                    <h1>0 أيام</h1>
                    <a href="/Posts/Create">
                        <button type="button" class="btn green-btn">
                            @AppResources.Label("CreatePost","ar")

                            <i class="bi bi-plus-lg"></i>
                        </button>
                    </a>
                </div>
            </div>
        </div>
        <!-- Card with button slider -->

    </div>
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <form asp-controller="Posts" asp-action="CreatePost" enctype="multipart/form-data" method="post" style="max-width: 100%;width: 100%;" id="create-form" dir="rtl">
                        <p class="card-title ms-auto">
                            <img src="~/Static/Icons/ligt-bulb.png" style="max-width: 50px !important" />
                            <span style="font-weight: bold" class="pe-2">@AppResources.Label("CreateYourNewPost","ar")</span>
                        </p>
                        <div class="mb-3">
                            <label for="Title">@AppResources.Label("Address","ar"):</label>
                            <input type="text" name="Title" id="Title" class="pe-1 quick_title" name="Title" style="border: none; border-bottom: 1px solid; outline: none; padding-right: 1px" />
                        </div>

                        <textarea type="text" class="w-100 pt-3" style="height: 200px; border-style: dashed; border-color: #c7d2de; outline: none" for="Content" id="Content"></textarea>
                        <input type="hidden" name="ShortTitle" for="ShortTitle" />
                        <input type="hidden" name="Summary" for="Summary" />
                        @*  <input type="datetime-local" name="PostDate" id="PostDate" class="hiddenDate" / >*@
                        <input type="submit" value="@AppResources.Label("CreateContent","ar") +" class="submit-button btn-primary p-3 mt-3 quick_submit" style="border-radius: 7px; width: 200px" />
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <p style="font-weight: bold ; font-size: 20px">@AppResources.Label("Archive","ar")</p>
        <p style="color: #a2aebc">@AppResources.Label("ChooseSuggestion", "ar")</p>
        <div class="d-flex flex-row-reverse justify-content-around flex-sm-wrap">
            @foreach (var post in userPosts.Take(4))
            {
                <div class="card p-3 justify-content-between rounded-3" style="width: 240px">
                    <div class="d-flex justify-content-between align-items-center mb-3 flex-row-reverse" style="font-size: 13px; color: #b3c1d3">
                        <span style="direction: ltr">
                            @post.PostDate
                        </span>
                        <div class="d-flex align-items-center" style="column-gap: 3px"><i class="bi bi-images"></i>@(post.PostMediaItems != null ? "1" : "0")</div>
                    </div>
                    <p> @post.Title</p>
                    <p class="content" style="height: 75px !important; white-space: nowrap;overflow: hidden;text-overflow: ellipsis;">@post.Content</p>
                    <div class="d-flex justify-content-between flex-row-reverse align-items-center">
                        <span style="background-color: #728894; color: white; border-radius: 50%; width: 20px; font-size:13px; display: block; text-align: center">@User.Identity?.Name!.Substring(0, 1).ToUpper()</span>


                        <div class="archive_menu">
                            <i class="bi bi-three-dots-vertical"></i>
                            <ul class="archive_operations">
                                <li>@Html.ActionLink(AppResources.Label("Update","ar"), "Edit", "Posts", new { @post.Id })</li>
                                <li><a href="/Social/Publish/Share?postid=@post.Id">@AppResources.Label("Share","ar")</a></li>
                                <li><a onclick="deletePost(this.id)" id="@post.Id">>@AppResources.Label("Delete", "ar")</a></li>
                            </ul>
                        </div>

                    </div>

                </div>
            }

        </div>

    </div>




    @await Html.PartialAsync("~/Views/Shared/_shareFromArchive.cshtml", data)
</div>



<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
<link rel="stylesheet" href="~/css/Index/index.css" />
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script src="~/js/Index/index.js"></script>