    </div>


    <div class="row">
        <div class="swiper mySwiper p-4" style="background-color: white;box-shadow: rgba(99, 99, 99, 0.2) 0px 2px 8px 0px;">
            <!-- Additional required wrapper -->
            <div class="swiper-wrapper">
                <!-- Slides -->
                @foreach (var post in posts.Take(10))
                {
                    <div class="swiper-slide post-list">

                        <p><span>العنوان : </span> @post.Title</p>
                        <p><span>التاريخ : </span> @post.PostDate</p>
                        <a href="/Posts/Edit/@post.Id">رابط الخبر</a>

                    </div>
                }

            </div>

            <!-- If we need navigation buttons -->
            <div class="swiper-button-prev"></div>
            <div class="swiper-button-next"></div>
        </div>
    </div>




    @await Html.PartialAsync("~/Views/Shared/_shareFromArchive.cshtml", data)
</div>

<style>
    a {
        text-decoration: none;
    }

    .swiper-slide {
        box-shadow: rgba(99, 99, 99, 0.2) 0px 2px 8px 0px;
        padding: 15px;
    }

    .post-list span {
        font-weight: bold;
    }

    .post-list a {
        font-weight: bold;
    }

    .swiper2 {
        position: relative;
        overflow: hidden;
        text-align: center;
    }


    @@media(max-width: 480px) {
        .swiper-slide {
            padding: 25px;
        }
    }

</style>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
