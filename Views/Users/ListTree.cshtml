@using FeedHiveAuth.Models.ViewModels;
@model List<UsersWithRolesViewModel>
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    var users = Model;
    //var Master = users.Where(x => x.role == "Master").FirstOrDefault()?.user.UserName;
    var Admins = users.Where(x => x.role == "Admin").ToList();
    var Editors = users.Where(x => x.role == "Editor").ToList();

}

<div class="col-md-12">
    <div class="card">
        <div class="card-header" style="background: #F6F9FC !important;">
            <h3>قائمة المستخدمين</h3>
        </div>
        <div class="d-flex align-items-center px-3 justify-content-between">
            <a asp-controller="Users" asp-action="Create" type="submit" class="btn btn-secondary mt-3" style="background: #0d6efd; height:fit-content; border-color: transparent; ">مستخدم جديد +</a>

            @* <div class="action-buttons">
                <button type="button" class="delete-btn my-3" onClick="deleteSelectedUsers()" style="width: fit-content;height: fit-content;padding: 7px 20px !important;">
                    حذف<i class="bi bi-trash me-2"></i>
                </button>
            </div> *@
        </div>
        <ul id="myUL" class="m-3">
            <li>
                <span class="caret">@users?.Where(x => x.role == "Master")?.FirstOrDefault()?.user.UserName</span>
                <ul class="nested">
                    @foreach (var admin in Admins)
                    {
                        <li>
                            <span class="caret last" style="border-right: 6px solid #dddddd">@admin.user.UserName</span>
                            <ul class="nested last">
                                @foreach (var editor in Editors.Where(x => x.ParentId == admin.user.Id).ToList())
                                {
                                    <span>
                                      @*   <i class="arrow right"></i> *@

                                    <li><a href="/Users/Edit/@editor.user.Id" style="color: black">@editor.user.UserName</a>  </li>
                                    @if (editor.user.Status == true)
                                    {

                                    @* <span class="badge text-bg-success">Active</span> *@
                                        <i class="bi bi-check"></i>
                                    }

                                    @if (editor.user.Status == false)
                                    {
                                    @* <span class="badge text-bg-danger">NotActive</span> *@
                                        <i class="bi bi-x"></i>
                                    }
                                    </span>
                                    
                                                
                                                

                                            }

                                


                            </ul>
                        </li>
                    }

                </ul>
            </li>
        </ul>

    </div>
</div>



<script>
    var toggler = document.getElementsByClassName("caret");
    var i;

    for (i = 0; i < toggler.length; i++) {
        toggler[i].addEventListener("click", function () {
            this.parentElement.querySelector(".nested").classList.toggle("active");
            this.classList.toggle("caret-down");
        });
    }
</script>

<link rel="stylesheet" href="~/css/users/ListTree.css" />
