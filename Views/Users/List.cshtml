@model List<IdentityUser>
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@{
    var users = Model;

}

<div class="col-md-12">
    <div class="card">
        <div class="card-header" style="background: #F6F9FC !important;">
            <h3>قائمة المستخدمين</h3>
        </div>
        <table id="filter" class="table mb-0" dir="rtl">
            <thead>
                <tr>
                    <th><input type="checkbox" name="selectAll" class="check" onClick="toggle(this)"><lablel for="selectAll"> اختر الكل</lablel></th>
                    <th>المستخدم</th>
                    <th>دور</th>
                </tr>
            </thead>
            <div class="d-flex align-items-center px-3 justify-content-between">
                <a asp-controller="Users" asp-action="Create" type="submit" class="btn btn-secondary" style="background: #0d6efd; height:fit-content">مستخدم جديد +</a>

                <div class="action-buttons">
                    <button type="button" class="delete-btn my-3" onClick="deleteSelectedUsers()" style="width: fit-content;height: fit-content;padding: 7px 20px !important;">
                        حذف<i class="bi bi-trash me-2"></i>
                    </button>
                </div>
            </div>

            <tbody>

                @if (users.Count != 0)
                {

                    @foreach (var user in users)
                    {
                        var userRole = await UserManager.GetRolesAsync(user);
                        var check = User.Identity?.Name;

                        <tr>
                            <td> <input type="checkbox" class="check" value="@(check == user.UserName ? "e" : user.Id)" @(check == user.UserName ? "disabled" : "")></td>
                            <td>@user.UserName</td>
                            @if (userRole.Any())
                            {
                                var ur = userRole.First();
                                <td>@ur</td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>




<link rel="stylesheet" href="~/css/Users/list.css"/>

<script src="~/js/Users/list.js"></script>



<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

