@model List<IdentityUser>
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@{
    var users = Model;

}

<div class="col-md-12">
    <div class="card">
        <div class="card-header">
            قائمة المستخدمين
        </div>
        <table id="filter" class="table" dir="rtl">
            <thead>
                <tr>
                    <th><input type="checkbox" name="selectAll" class="check" onClick="toggle(this)"><lablel for="selectAll"> اختر الكل</lablel></th>
                    <th>المستخدم</th>
                    <th>دور</th>
                </tr>
            </thead>
            <a asp-controller="Users" asp-action="Create" type="submit" class="btn btn-secondary" style="width:150px">مستخدم جديد</a>

            <div class="action-buttons">
                <button type="button" class="delete-btn my-3 me-2" onClick="deleteSelectedUsers()" style="width: 100px; height: auto">حذف</button>
            </div>

            <tbody>

                @if (users.Count != 0)
                {

                    @foreach (var user in users)
                    {
                        var userRole = await UserManager.GetRolesAsync(user);
                        var check = user == users.FirstOrDefault() ? "disabled" : "";

                        <tr>
                            <td> <input type="checkbox" class="check" @check value="@(check == "disabled" ? "" : user.Id)"></td>
                            <td>@user.UserName</td>
                            @if (userRole.Any())
                            {
                                var ur = userRole.First();
                                <td>@ur</td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>


<style>
    .check {
        width: 20px;
        height: auto;
        box-shadow: none;
    }

    main input {
        max-width: 100%;
        margin-bottom: 20px;
        border: none;
        border-radius: 5px;
        margin-bottom: 0px;
    }
</style>