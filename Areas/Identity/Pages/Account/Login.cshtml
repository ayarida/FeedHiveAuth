@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
    Layout = null;
}

<h1 class="mt-5">@ViewData["Title"]</h1>
<div class="row gy-5">
    <div class="col-md-12 login-section p-5">
        <section>
            <form id="account" method="post">
                <h2>Use a local account to log in.</h2>
                <hr />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <label for="username">Username</label>
                <div class="form-floating">
                    <input asp-for="Input.Username" id="username" class="form-control" autocomplete="username" aria-required="true" />
                    <label asp-for="Input.Username" class="form-label"></label>
                    <span asp-validation-for="Input.Username" class="text-danger"></span>
                </div>
                <label for="password" class="mt-4">Password</label>
                <div class="form-floating">
                    <input asp-for="Input.Password" id="password" class="form-control" autocomplete="current-password" aria-required="true" />
                    <label asp-for="Input.Password" class="form-label"></label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <div class="mt-3">
                    <div class="checkbox" style="display: flex;justify-content: flex-start;" dir="auto">
                        <label asp-for="Input.RememberMe" class="form-label">
                            <input class="form-check-input" asp-for="Input.RememberMe" />
                            @Html.DisplayNameFor(m => m.Input.RememberMe)
                        </label>
                    </div>
                </div>
                <div class="mt-3">
                    <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary">Log in</button>
                </div>
                <div class="mt-4 account-options">
                    <p>
                        <a id="forgot-password" asp-page="./ForgotPassword" dir="auto">Forgot your password?</a>
                    </p>
                    <p>
                        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" dir="auto">Register as a new user</a>
                    </p>
                    <p>
                        <a id="resend-confirmation" asp-page="./ResendEmailConfirmation" dir="auto">Resend email confirmation</a>
                    </p>
                </div>
            </form>
        </section>
    </div>
    <div class="col-md-12 col-md-offset-2">
        <section>
            <h3>Use another service to log in.</h3>
            <hr />
            @{
                if ((Model.ExternalLogins?.Count ?? 0) == 0)
                {
                    <div>
                        <p>
                            There are no external authentication services configured. See this <a href="https://go.microsoft.com/fwlink/?LinkID=532715">
                                article
                                about setting up this ASP.NET application to support logging in via external services
                            </a>.
                        </p>
                    </div>
                }
                else
                {
                    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="form-horizontal">
                        <div>
                            <p>
                                @foreach (var provider in Model.ExternalLogins!)
                                {
                                    <button type="submit" class="btn btn-primary" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">@provider.DisplayName</button>
                                }
                            </p>
                        </div>
                    </form>
                }
            }
        </section>
    </div>
</div>


<style>
    main {
        direction: ltr;
        text-align: left;
      
      p{
          direction: ltr;
      }

    a {
        text-decoration: none;
        color: inherit;
    }

    }

    .login-section {
        border: 8px solid #707efd;
        border-radius: 20px;
    }

    #account {
        row-gap: 5px;
        display: flex;
        flex-direction: column;
    }

    .account-options p{
        text-align: end;
    }

    .login-section a {
        color: inherit;
        text-decoration: none;
    }

</style>



@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}




