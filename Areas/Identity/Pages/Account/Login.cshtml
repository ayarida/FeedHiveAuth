@page
@model LoginModel

@{

    Layout = null;
}

<h1 class="mt-5">@ViewData["Title"]</h1>
<div class="row gy-5 justify-content-center mt-auto">
    <div class="login-section">
        <section>
            <img src="/Static/Images/logo-minimal.png" alt="logo"/>
            <form id="account" method="post" dir="rtl">
                <h2>تسجيل الدخول</h2>
                @*  <hr /> *@
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-floating">
                    <input asp-for="Input.Username" id="username" class="form-control" autocomplete="username" aria-required="true" placeholder="اسم المستخدم"/>
                    @* <label asp-for="Input.Username" class="form-label"></label> *@
                    <span asp-validation-for="Input.Username" class="text-danger"></span>
                </div>

                <div class="form-floating">
                    <input asp-for="Input.Password" id="password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="كلمة المرور"/>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <div class="mt-3">
                    <div class="checkbox">
                        <label asp-for="Input.RememberMe" class="form-label">
                            حفظ المعلومات
                        </label>
                        <input class="form-check-input" asp-for="Input.RememberMe"/>


                    </div>
                </div>
                <div class="mt-3" style="text-align: center">
                    <button id="login-submit" type="submit" class=" btn btn-lg btn-primary p-3">تسجيل الدخول</button>
                </div>
                <p class="forget">
                    <a id="forgot-password" asp-page="./ForgotPassword" style=" font-weight: bold">نسيت كلمة السر ؟</a>
                </p>
            </form>
        </section>
    </div>
</div>


<style>
    
    body {
        background-image: url("/Static/Images/login-background.png");
        background-size: cover;
        background-repeat: no-repeat;
        direction: rtl;
    }

    main, h2 {
        direction: rtl;
        text-align: right;
    }

    p {
        direction: rtl;
    }

    .login-section {
        box-shadow: 0 4px 100px 0 #00000040;
        background: white;
        border-radius: 16px !important;
        max-width: 500px !important;
        padding: 20px 30px !important;
    }

    .login-section img {
        width: 118px;
        height: 108px;
        display: flex;
        margin: auto;
    }

    .login-section h2 {
        text-align: center;
        font-weight: bold;
        font-size: 30px;
        margin-top: 30px;
    }

    .login-section input {
        box-shadow: 1px 1px 10px 0 #00000040;
        border-radius: 29px !important;
    }
    .form-floating input {
        padding: 12px !important;
        height: 50px !important;
    }
    
    .login-section  input::placeholder {
        color: #575757 !important;
        opacity: 0.8;
    }
    
    .login-section .form-floating {
        position: relative;
        margin: 25px auto auto;
    }
    
    .login-section .checkbox {
        margin: auto;
            display: flex;
            column-gap: 10px;
    }

    .login-section .checkbox .form-label {
        order: 1;
    }

    .login-section input.form-check-input {
        width: 18px;
        height: 18px;
        border-radius: 4px !important;
        box-shadow: none;
        border: 2px solid #272727;
    }

    input.form-check-input:checked {
        background-color: transparent !important;
        border-color: #272727 !important;
        background-image: url("data:image/svg+xml;utf8,\
<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'>\
<path fill='black' d='M13.485 1.929l-7.071 7.071-3.536-3.536-1.414 1.414 4.95 4.95 8.485-8.485z'/>\
</svg>") !important;
        background-repeat: no-repeat;
        background-position: center;
        background-size: 14px 14px;
    }
    
        #login-submit {
            background: #FA961E;
            border-color: transparent;
            border-radius: 30px;
            box-shadow: none;
            color: black;
            font-weight: bold;
            display: flex;
            margin: auto;
            width: 100%;
            height: 50px;
            justify-content: center;
            align-items: center;
        }

    .forget {
        text-align: right;
        margin-top: 15px;
    }
    
</style>



@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}




<link rel="stylesheet" href="~/css/LandingPage/landingPage.css" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />

<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@200;300;400&family=IBM+Plex+Sans+Arabic&display=swap"
      rel="stylesheet" />
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />

<link rel="stylesheet" href="~/css/Sidebar/navbar.css" />
<link rel="stylesheet" href="~/css/Sidebar/core.css" />