@page
@model RegisterModel
@{
    var x = Model;
    var subId = HttpContext.Session.GetString("subscriptionId");
    Layout = null;
}

<h1>@ViewData["Title"]</h1>

<form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" dir="rtl">
    <h2 style="text-align : right">أنشئ حسابًا جديدًا</h2>
    <hr />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="sign-up-card">
        <div class="sign-up-header">
            @* <h2 class="sign-up-title">ابدأ دون أي تكلفة</h2> *@
            <h3 class="sign-up-title2">أنشئ حسابًا جديدًا</h3>
 @*            <button class="sign-up-google">
                Google
                <i class="bi bi-google"></i>
            </button> *@
        </div>
        <div class="sign-up-name">
            <input asp-for="Input.Username" class="" autocomplete="username" aria-required="true" type="text" id="field" placeholder="اسم المستخدم" />
            <span asp-validation-for="Input.Username" class="text-danger"></span>
        </div>
        <div class="sign-up-email">
            <input asp-for="Input.Email" class="" autocomplete="username" aria-required="true" type="text" id="field" placeholder="بريد إلكتروني" />
            @*                 <label asp-for="Input.Email"></label>
            *@                <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>

        <div class="password">
            <input asp-for="Input.Password" class="" autocomplete="new-password" aria-required="true" placeholder="كلمة المرور" />
            @*                 <label asp-for="Input.Password"></label>
            *@                <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>
        <div class="confirm-password">

            <input id="field-2" asp-for="Input.ConfirmPassword" class="" autocomplete="new-password" aria-required="true" type="password" placeholder="تأكيد كلمة المرور" />
            @*                 <label asp-for="Input.ConfirmPassword"></label>
            *@                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
        </div>

        <div class="sign-up-control d-flex flex-column align-items-center">
            <button id="registerSubmit" type="submit" class="control mt-4">
                أنشئ حسابًا جديدًا
                <span><i class="bi bi-arrow-left-short"></i></span>
            </button>
            <h4 class="privacy-policy mb-4">
                من خلال التسجيل، فإنك توافق على شروطنا وخدماتنا وتقر بسياسة الخصوصية الخاصة بنا
            </h4>
        </div>
    </div>
</form>

<div class="col-md-6 col-md-offset-2">
    <section>
        @* <h3>Use another service to register.</h3>*@
        @{
            if ((Model.ExternalLogins?.Count ?? 0) == 0)
            {
                // <div>
                //     <p>
                //         There are no external authentication services configured. See this <a href="https:go.microsoft.com/fwlink/?LinkID=532715">article
                //         about setting up this ASP.NET application to support logging in via external services</a>.
                //     </p>
                // </div>
            }
            else
            {
                <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="form-horizontal">
                    <div>
                        <p>
                            @foreach (var provider in Model.ExternalLogins!)
                            {
                                <button type="submit" class="btn btn-primary" name="provider" value="@provider.Name" title="تسجيل الدخول مع @provider.DisplayName account">@provider.DisplayName</button>
                            }
                        </p>
                    </div>
                </form>
            }
        }
    </section>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


<link rel="stylesheet" href="~/css/Register/Register.css" />

<link rel="stylesheet" href="~/css/LandingPage/landingPage.css" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />

<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@200;300;400&family=IBM+Plex+Sans+Arabic&display=swap"
      rel="stylesheet" />
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />

