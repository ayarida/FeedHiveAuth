@page
@model EmailModel
@{
    ViewData["Title"] = "إدارة البريد الإلكتروني";
    ViewData["ActivePage"] = ManageNavPages.Email;

}

<h3>@ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />
<div class="row">
    <div class="col-md-6">
        <form id="email-form" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            @if (Model.IsEmailConfirmed)
            {
                <div class="form-floating input-group">
                    <input asp-for="Email" class="form-control mb-3" disabled />
                    @*      <div class="input-group-append">
                <span class="h-100 input-group-text text-success font-weight-bold">✓</span>
                </div> *@
                    <label asp-for="Email" class="form-label">لبريد الإلكتروني</label>
                </div>
            }
            else
            {
                <div class="form-floating">
                    <input asp-for="Email" class="form-control mb-3" disabled />
                    <label asp-for="Email" class="form-label">البريد الإلكتروني</label>
                    <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail" class="btn btn-link">Send verification email</button>
                </div>
            }
            <div class="form-floating">
                <input asp-for="Input.NewEmail" class="form-control mb-3" autocomplete="email" aria-required="true" />
                <label asp-for="Input.NewEmail" class="form-label">البريد الإلكتروني الجديد</label>
                <span asp-validation-for="Input.NewEmail" class="text-danger"></span>
            </div>
            <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="w-100 btn btn-lg btn-primary">غير البريد الإلكتروني</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


<style>
    #email-form input{
        text-align: right;
    } 
    .form-floating > label{
        left: auto !important;
        right: 0;
        padding-right: 0 !important;
    }

</style>