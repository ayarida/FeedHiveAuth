@using FeedHiveAuth.Data.Helpers;
@inject SignInManager<IdentityUser> SignInManager
@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
}
<ul class="nav nav-pills flex-column p-0">
    <li class="nav-item"><a class="nav-link @ManageNavPages.IndexNavClass(ViewContext)" id="profile" asp-page="./Index">@AppResources.Label("Account")</a></li>
    <li class="nav-item"><a class="nav-link @ManageNavPages.EmailNavClass(ViewContext)" id="email" asp-page="./Email">@AppResources.Label("email")</a></li>
    <li class="nav-item"><a class="nav-link @ManageNavPages.ChangePasswordNavClass(ViewContext)" id="change-password" asp-page="./ChangePassword">@AppResources.Label("password")</a></li>
    @if (hasExternalLogins)
    {
        <li id="external-logins" class="nav-item"><a id="external-login" class="nav-link @ManageNavPages.ExternalLoginsNavClass(ViewContext)" asp-page="./ExternalLogins">@AppResources.Label("external logins")</a></li>
    }
    <li class="nav-item"><a class="nav-link @ManageNavPages.TwoFactorAuthenticationNavClass(ViewContext)" id="two-factor" asp-page="./TwoFactorAuthentication">@AppResources.Label("two factor authentication")</a></li>
    <li class="nav-item"><a class="nav-link @ManageNavPages.PersonalDataNavClass(ViewContext)" id="personal-data" asp-page="./PersonalData">@AppResources.Label("personal data")</a></li>
</ul>

<style>
    .nav-link:not(.active) {
        color: unset;
        padding-right: 0;
    }

    #profile-form {
        display: flex;
        flex-direction: column;
        row-gap: 16px;
        column-gap: 10px;
    }

    .alert.alert-success.alert-dismissible{
        display: flex;
        padding-right: 10px;
        align-items: center;
        column-gap: 10px;
    }

    .alert-dismissible .btn-close {
        position: relative !important;
    }

</style>