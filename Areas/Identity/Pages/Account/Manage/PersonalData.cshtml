@page
@model PersonalDataModel
@{
    ViewData["Title"] = "البيانات الشخصية";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h3>@ViewData["Title"]</h3>

<div class="row">
    <div class="col-md-6">
        <p>يحتوي حسابك على البيانات الشخصية التي منحتنا إياها. تتيح لك هذه الصفحة بتنزيل تلك البيانات أو حذفها.</p>
        <p>
            <strong>سيؤدي حذف هذه البيانات إلى إزالة حسابك بشكل دائم، ولا يمكن استرداد هذه البيانات.</strong>
        </p>
        <form id="download-data" asp-page="DownloadPersonalData" method="post">
            <button class="btn btn-primary mb-3" type="submit" style="max-width: 100%">تحميل</button>
        </form>
        <p>
            <a id="delete" asp-page="DeletePersonalData" class="btn btn-danger">احذف هذا الحساب</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    #delete {
        width: 100%;
        height: 60px;
        display: flex;
        justify-content: center;
        align-items: center;
    }
</style>