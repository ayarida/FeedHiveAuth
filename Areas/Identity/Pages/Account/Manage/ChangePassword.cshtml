@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "غير كلمة المرور";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<h3>@ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />
<div class="row">
    <div class="col-md-6">
        <form id="change-password-form" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-floating">
                <input asp-for="Input.OldPassword" class="form-control mb-3" autocomplete="current-password" aria-required="true" />
                <label asp-for="Input.OldPassword" class="form-label">كلمة المرور الحالية</label>
                <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
            </div>
            <div class="form-floating">
                <input asp-for="Input.NewPassword" class="form-control mb-3" autocomplete="new-password" aria-required="true" />
                <label asp-for="Input.NewPassword" class="form-label">كلمة مرور جديدة</label>
                <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
            </div>
            <div class="form-floating">
                <input asp-for="Input.ConfirmPassword" class="form-control mb-3" autocomplete="new-password" aria-required="true" />
                <label asp-for="Input.ConfirmPassword" class="form-label">تأكيد كلمة المرور الجديدة</label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">تحديث كلمة المرور</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    form input {
        padding: 10px 1rem 0 0 !important;
    }

    #change-password-form input {
        text-align: right;
    }

    .form-floating > label {
        left: auto !important;
        right: 0;
        padding-right: 0 !important;
    }
</style>