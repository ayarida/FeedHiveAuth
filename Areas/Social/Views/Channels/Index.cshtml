@model List<FeedHiveAuth.Models.Channel>
@using FeedHiveAuth.Models.Enums
@using FeedHiveAuth.Data.Extensions
@using FeedHiveAuth.Services

@{
    ViewData["Title"] = "Index";
    var channels = Model;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var channelStatuses = new List<StatusEnum> { StatusEnum.Active, StatusEnum.InActive, StatusEnum.Deleted, StatusEnum.Expired };
    var networks = EnumExtension.GetAllList<SocialNetworkTypeEnum>();
    var accounts = EnumExtension.GetAllList<SocialAccountTypeEnum>();
    var curr = GlobalContext.UserConfigs?.UserData;
    // var subscription = GlobalContext.Application["currentSubscription"];
}

<table dir="rtl">
    <tr style="background-color: #edecf3 !important">
        <th>القناة</th>
        <th>النوع</th>
        <th>الحالة</th>
    </tr>

    @foreach (var channel in channels)
    {
        <tr>

            <td><img src="@channel.ProfileImageUrl" /> <span>@channel.OriginalName</span></td>
            <td style="column-gap: 4px" class="channel-icon">
                <div class="d-flex align-items-center" style="column-gap: 10px">
                    <i class="bi bi-@(channel.Network == "dailymotion" ? "camera-video" : channel.Network) social-icon"></i>
                    <a href="@channel.NetworkUrl"><i class="bi bi-box-arrow-up-right"></i></a>
                </div>
            </td>
            <td>
                @{
                    var channelStatus = EnumExtension.FromValue<StatusEnum>(channel.Status);
                    if (channelStatus == StatusEnum.Active)
                    {
                        <div class="status status_active">Active</div>
                    }
                    else
                    {
                        <div class="status status_inactive">Inactive</div>
                    }
                }
            </td>


        </tr>
    }


</table>

<style>
    table {
        font-family: arial, sans-serif;
        border-collapse: collapse;
        width: 100%;
    }

        table img {
            width: 115px;
            height: auto;
        }

    td {
        text-align: right !important;
        direction: rtl;
        width: 1%;
        white-space: nowrap;
    }

    td, th {
        text-align: right;
        padding: 8px;
    }

    th {
        text-align: right !important;
    }

    tr:nth-child(even) {
        background-color: #dddddd;
    }

    i.bi.bi-telegram.social-icon {
        color: #2fa3d9;
    }

    .channel-icon {
        font-size: 24px;
    }

    tr {
        background-color: white !important;
    }

    .status_active {
        background-color: #31bd36;
    }


    .status_inactive {
        background-color: #dfaa0f;
    }

    table span {
        margin-right: 10px;
    }

    .status {
        text-align: center;
        display: flex;
        justify-content: center;
        color: white;
        padding: 8px;
        border-radius: 4px;
        width: 93px;
    }

    i.bi.bi-box-arrow-up-right {
        color: black !important;
    }
</style>