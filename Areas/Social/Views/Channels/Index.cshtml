@model List<FeedHiveAuth.Models.Channel>
@using FeedHiveAuth.Models.Enums
@using FeedHiveAuth.Data.Extensions
@using FeedHiveAuth.Services

@{
    ViewData["Title"] = "Index";
    var channels = Model;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var channelStatuses = new List<StatusEnum> { StatusEnum.Active, StatusEnum.InActive, StatusEnum.Deleted, StatusEnum.Expired };
    var networks = EnumExtension.GetAllList<SocialNetworkTypeEnum>();
    var accounts = EnumExtension.GetAllList<SocialAccountTypeEnum>();
    var curr = GlobalContext.UserConfigs?.UserData;
    // var subscription = GlobalContext.Application["currentSubscription"];
}

<table>
    <tr>Channel</tr>
    <tr>Status</tr>
    <tr>Authorization</tr>
    @foreach (var channel in channels)
    {
        <tr>
            <td>@(channel.Network == null ? "N/A" : channel.Network)</td>
       @*      <td>@(channel.Status.ToString() == null ? "Uknown" : channel<StatusEnum> { StatusEnum.Active ,  StatusEnum.InActive, StatusEnum.Deleted, StatusEnum.Expired})</td> *@
        </tr>
    }
</table>

<style>
    table {
        font-family: arial, sans-serif;
        border-collapse: collapse;
        width: 100%;
    }

    td, th {
        border: 1px solid #dddddd;
        text-align: left;
        padding: 8px;
    }

    tr:nth-child(even) {
        background-color: #dddddd;
    }
</style>