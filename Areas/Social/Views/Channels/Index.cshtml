@model IEnumerable<FeedHiveAuth.Models.Channel>
@using FeedHiveAuth.Models.Enums
@using FeedHiveAuth.Data.Extensions
@using FeedHiveAuth.Services
@using FeedHiveAuth.Data.Helpers;


@{
    ViewData["Title"] = "Index";
    var channels = Model;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var channelStatuses = new List<StatusEnum> { StatusEnum.Active, StatusEnum.InActive, StatusEnum.Deleted, StatusEnum.Expired };
    var networks = EnumExtension.GetAllList<SocialNetworkTypeEnum>();
    var accounts = EnumExtension.GetAllList<SocialAccountTypeEnum>();
    var curr = GlobalContext.UserConfigs?.UserData;
    var configs = SocialServiceHelper.getSocialConfigs();
    var defaultimg = configs.TechnicalConfigs?.appTechnicalConfigs?.DefaultImageUrl ?? "";
}


<div style=" width: 100%; text-align: right" class="pb-2">
    <a style="background: #0d6efd;height: fit-content; border: none" class="btn btn-secondary" href="/Social/Channels/Create">إنشاء قناة جديدة +</a>
</div>

<div class="card">
    <table dir="rtl" class="table table-sm table-bordered table-bordered mb-0">
        <tr style="background-color: #edecf3 !important; border: 1px solid #dbdae1">
            <th>القناة</th>
            <th>النوع</th>
            <th>الحالة</th>
        </tr>


        @foreach (var channel in channels)
        {
            <tr>

                <td>
                    @if (channel.ProfileImageUrl != null)
                    {
                        <div class="d-flex align-items-center">
                            <img src="@channel.ProfileImageUrl" /> <span>@channel.OriginalName</span>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center">
                            <img src="@defaultimg" style="border: 1px solid grey;" />

                            <span>@channel.OriginalName</span>
                        </div>
                    }
                </td>
                <td style="column-gap: 4px" class="channel-icon">
                    <div class="d-flex align-items-center justify-content-center" style="column-gap: 10px">
                        <i class="bi bi-@(channel.Network == "dailymotion" ? "camera-video" : channel.Network) social-icon"></i>
                        <a href="@channel.NetworkUrl"><i class="bi bi-box-arrow-up-right"></i></a>
                    </div>
                </td>
                <td>
                    @{
                        var channelStatus = EnumExtension.FromValue<StatusEnum>(channel.Status);
                        if (channelStatus == StatusEnum.Active)
                        {
                            <div class="w-100  d-flex align-items-center justify-content-center">
                                <div class="status status_active">Active</div>
                            </div>
                        }
                        else
                        {
                            <div class="w-100 d-flex align-items-center justify-content-center">
                                <div class="status status_inactive ">Inactive</div>
                            </div>
                        }
                    }
                </td>


            </tr>
        }


    </table>

</div>
<link rel="stylesheet" href="~/css/Channels/list.css" />