                        <h1 class="text-center p-3 font-weight-bold">إنشاء قناة جديدة</h1>

                    </div>
                    <div class="card-body">
                        <form id="assessment-form">

                            <button id="loadNetworks">
                                Get networks
                            </button>

                            <div id="placeholder">
                                Replace here
                            </div>

                            <div class="row d-flex nav-buttons justify-content-center ">
                                <div class="">
                                    <button type="button" id="next">
                                        التالي <i class="fa fa-arrow-right"></i>
                                    </button>
                                </div>

                                <div class="back-button">
