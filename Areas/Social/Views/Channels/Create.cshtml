<style>
    .nw-form-control::placeholder {
        color: grey;
    }


    .nw-form-control:focus {
        outline: none;
        border: none;
        background-color: rgb(158, 120, 251);
        color: white;
        font-weight: bold;
        box-shadow: 3px 3px 2px black;
    }

        .nw-form-control:focus::placeholder {
            color: white;
        }

    textarea.nw-form-control {
        height: 21vh;
    }

    select.nw-form-control {
        padding: 0.5rem;
    }


    .nav-buttons button {
        width: 200px;
        max-width: 100%;
    }

    .nav-buttons {
        row-gap: 10px;
    }



    .row.d-flex.nav-buttons > div {
        width: fit-content;
    }


    #assessment-form {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }


    .social .infobox {
        cursor: pointer;
        text-align: center !important;
        border: 1px solid transparent;
        background: #2e88e1;
        color: white;
        border-radius: 5px;
        padding: 20px;
        width: 200px;
    }


    .selected-div {
        border: 6px solid #2262a2;
    }

    /* Style for channel selection */

    .radio-group {
        position: relative;
    }

    .radio {
        display: inline-block;
        width: 15px;
        height: 15px;
        border-radius: 100%;
        background-color: lightblue;
        border: 2px solid lightblue;
        cursor: pointer;
        margin: 2px 0;
    }

        .radio.selected {
            border-color: blue;
        }

    #assessment-form{
        width: 100%;
    }
    
    .channel_list{
        text-align: left;
        margin-left: 70px !important;
        text-decoration: underline;
        color: black;
        text-underline-offset: 5px;
        margin-top: 20px;
        width: fit-content;
        margin-right: auto;
        padding: 20px;
        border-radius: 5px;
        font-weight: bold;
        font-size: 20px;
    }
</style>