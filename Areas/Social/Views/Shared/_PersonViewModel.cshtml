@using FeedHiveAuth.Areas.Social.Models;
@using Microsoft.AspNetCore.Identity;
@model FeedHiveAuth.Areas.Social.Models.ShareView
@{
    var model = Model;
}


<div class="form-items">
    @using (Html.BeginForm("Share", "Publish", new { area = "Socia" }, FormMethod.Post))
    {
        <div>
            <span>Post Id</span>
            @Html.TextAreaFor(m => m.Post.Id)
        </div>

        <div>
            <span>Media Id</span>
            @Html.TextAreaFor(m => m.Media.Id)
        </div>


        @*        <div>
    <span>Channel Id</span>
    @Html.TextAreaFor(m => m.Channels);
    </div> *@

    }

    <input type="submit" value="Submit" class="btn btn-primary mt-4" style="max-width: 200px;" />
</div>

<style>
    .form-items div {
        display: flex;
        flex-direction: column;
    }
</style>