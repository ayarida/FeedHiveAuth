@using FeedHiveAuth.Areas.Social.Models
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using FeedHiveAuth.Data.Helpers
@{
    var socialConfigs = SocialServiceHelper.GetConfigs();
}






<ul class="telegramSetup mt-4" style="width: 100%">

    @*     <li>افتح هذا البوت في تيليجرام</li>
    <li>اانقر زر إرسال الرسالة</li> *@
    <li>Open This Bot In Telegram @socialConfigs.TelegramConfigs?.Bot?.Username</li>
    <li>Click Send Message Button</li>
    <li>Click Start Button</li>
    <li>Go To Your Telegram Channel</li>
    <li>Click Add Members</li>
    <li>Enter Bot Name</li>
    <li>Click Invite Button</li>
    <li>Click Make Admin Button</li>


</ul>


<form asp-area="Social" asp-controller="Authorization" asp-action="OAuthFlow" method="post">
    <input type="hidden" value="Telegram" name="network" />
    <input type="hidden" value="Page" name="account" />
    <input type="hidden" value="false" name="reauthorize" />
    <lable for="channelUsername">Channel Username</lable>
    <input asp-for-id="@socialConfigs?.TelegramConfigs?.Bot.Username" name="id" type="text">
    <input type="submit" value="Submit" />
    @Html.AntiForgeryToken();
</form>
@* <button>Click Authorize Button<i class="bi bi-unlock"></i></button> *@

<style>

    ul.telegramSetup {
        list-style: none;
    }

        ul.telegramSetup li:before {
            content: '✓';
            color: green;
            margin-left: 5px;
        }

        ul.telegramSetup li {
            margin-bottom: 20px;
            font-size: 20px;
        }


    #channelContainer {
        width: 100%;
    }

    .channelName {
        display: block;
        width: 100%;
        padding: 0.375rem 0.75rem;
        font-size: 1rem;
        font-weight: 400;
        line-height: 1.5;
        color: var(--bs-body-color);
        -webkit-appearance: none;
        -moz-appearance: none;
        appearance: none;
        background-color: var(--bs-body-bg);
        background-clip: padding-box;
        border: var(--bs-border-width) solid var(--bs-border-color);
        border-radius: var(--bs-border-radius);
        transition: border-color .15s ease-in-out,box-shadow .15s ease-in-out;
    }
</style>