@using FeedHiveAuth.Areas.Social.Models
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using FeedHiveAuth.Data.Helpers
@{
    var socialConfigs = SocialServiceHelper.GetConfigs();
}


<h1 style="text-align: left" class="mb-3">DailyMotion Channel</h1>

<form asp-area="Social" asp-controller="Authorization" asp-action="OAuthFlow" method="post" dir="rtl">
    <div class="d-flex mb-3 align-items-end flex-column" style="column-gap: 20px">

        <input type="hidden" value="Dailymotion" name="network" />

        <lable for="channelUsername">Channel Name</lable>
        <input name="id" type="text" class="form-control" id="channelUsername">

        <lable for="username">Username</lable>
        <input name="username" type="text" class="form-control" id="username">

        <lable for="password">Password</lable>
        <input name="password" type="text" class="form-control" id="password">

        <lable for="apisecrete">API Secret</lable>
        <input name="apisecrete" type="text" class="form-control" id="apisecrete">

        <lable for="apikey">API Key</lable>
        <input name="apikey" type="text" class="form-control" id="apikey">

        <lable for="callbackurl">Callback URL</lable>
        <input name="callbackurl" type="text" class="form-control" id="callbackurl">

        <lable for="localpath">Local Path</lable>
        <input name="localpath" type="text" class="form-control" id="localpath">

    </div>
    <input type="submit" value="Authorize" class="btn btn-primary submit-button" style=" width: 200px !important; display: block; margin-right: auto" />
    @Html.AntiForgeryToken()
</form>

<style>
    form input {
        box-shadow: 0px 0px 6px #00000029;
        width: 500px !important;
        max-width: 100%;
        margin-bottom: 20px;
    }

    form label {
        font-size: 20px;
    }

    div#channelContainer{
        width: 100%;
    }
</style>
