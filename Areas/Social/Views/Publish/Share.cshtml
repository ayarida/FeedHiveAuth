@using FeedHiveAuth.Areas.Social.Models;
@using Microsoft.AspNetCore.Identity;
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@model FeedHiveAuth.Areas.Social.Models.ShareView
@{
    var post = Model.Post;
    var media = Model.Media;
    var socialConfigs = new SocialConfigs();
    var activeNetworkTypes = Model.ActiveSocialNetworks;

    var allChannels = Model.Channels.Where(channel => activeNetworkTypes.Select(networkType => networkType.ToString().ToLower()).Contains(channel.Network.ToLower()));
    var channelIds = allChannels.Select(x => x.NetworkId);
    var loggedInUser = User?.Identity.Name;
}

<div class="page-content">
</div>
