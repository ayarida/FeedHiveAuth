@using FeedHiveAuth.Areas.Social.Models;
@using Microsoft.AspNetCore.Identity;
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@model FeedHiveAuth.Areas.Social.Models.ShareView

@{
    var post = Model.Post;
    var media = Model.Media;
    var socialConfigs = new SocialConfigs();
    var activeNetworkTypes = Model.ActiveSocialNetworks;

    Layout = "~/Views/Shared/_Layout.cshtml";

    var allChannels = Model.Channels.Where(channel => activeNetworkTypes.Select(networkType => networkType.ToString().ToLower()).Contains(channel.Network.ToLower()));
    var channelIds = allChannels.Select(x => x.NetworkId);
    var loggedInUser = User?.Identity?.Name;
}


<div class="editor ms-auto pe-3" dir="rtl" style="background: #8080800f; max-width: 100%; width: 600px">
    <div class="container pt-4 mt-4">
        <div class="form-items">

            @using (Html.BeginForm("Send", "Publish", new { area = "Social" }, FormMethod.Post))
            {
                <h4>شبكات التواصل</h4>
                <hr />

                <div class="channel-list my-3 d-flex" style="column-gap: 20px; overflow-x: auto">

                    @{
                        var index = 0;
                    }
                    @foreach (var channel in allChannels)
                    {

                        <div class="channel d-flex flex-column align-items-center pb-4" style="width: fit-content">
                            <div class="d-flex flex-row-reverse">
                                <p class="text-capitalize mb-1">@channel.Network</p>
                                <i class="bi bi-@channel.Network social-icon ms-2"></i>
                            </div>
                            <img src="~/uploads/test.jpg" style="max-width: 90px; max-height= 90px:" />
                            <label for="@channel.Network">
                                @channel.OriginalName
                            </label>

                            <input type="checkbox" id="Channels[@index]" name="Channels[@index]" value="@channel.Network" style="width: fit-content !important; height: auto" />
                        </div>


                        <input type="hidden" name="Data[@index].ChannelId" id="Data[@index].ChannelId" value="@channel.Id" />
                    }
                </div>

                <div class="input-fields d-flex flex-column mt-4">

                    <div class="form-group mb-4">
                        <label class="mb-2 control-label">عنوان المنشور</label>
                        <br />
                        <input class="form-control" value="@post.Title" name="@post.Title" readonly />
                    </div>

                    <div class="form-group mb-4">
                        <label class="mb-2 control-label">عنوان قصير</label>
                        <br />
                        <input value="@post.ShortTitle" name="@post.ShortTitle" readonly />
                    </div>

                    <div class="form-group mb-4">
                        <label class="mb-2 control-label">ملخص</label>
                        <br />
                        <input value="@post.Summary" name="@post.Summary" readonly />
                    </div>

                    <div class="form-group mb-4">
                        <label class="mb-2 control-label">محتوى</label>
                        <br />
                        <input value="@post.Content" name="@post.Content" readonly />
                    </div>


                    <div class="form-group mb-4">
                        @if (media != null)
                        {
                            <label for="MediaId" class="mb-2 control-label">ميديا </label>
                            <br />
                            <img name="MediaId" class="mt-3" id="MediaId" src="@media.Path" />
                        }
                    </div>
                </div>

                <input type="submit" value="أرسل" class="btn btn-primary mt-3" style="max-width: 200px;" />
            }

        </div>
    </div>
</div>

<style>


    input {
        text-align: start;
    }

    input {
        width: 510px !important;
        max-width: 100%;
        border-color: #212c37 !important;
        text-align: right;
    }

    form input {
        padding-right: 10px !important;
    }

    form img {
        width: 400px;
        max-width: 100%;
    }

    .social-icon::before {
        font-size: 20px;
    }

    .channel-list {
        -webkit-overflow-scrolling: touch;
    }

    /* ===== Scrollbar CSS ===== */
    /* Firefox */
    * {
        scrollbar-width: thin;
        scrollbar-color: #918b92 #ffffff;
    }

        /* Chrome, Edge, and Safari */
        *::-webkit-scrollbar {
            width: 5px;
            height: 15px;
        }

        *::-webkit-scrollbar-track {
            background: #ffffff;
        }

        *::-webkit-scrollbar-thumb {
            background-color: #918b92;
            border-radius: 10px;
            border: 4px solid #ffffff;
        }


    .form-container {
        row-gap: 7px;
    }
</style>


