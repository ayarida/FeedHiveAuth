@using FeedHiveAuth.Areas.Social.Models;
@using Microsoft.AspNetCore.Identity;
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@model FeedHiveAuth.Areas.Social.Models.ShareView

@{
    var post = Model.Post;
    var media = Model.Media;
    var socialConfigs = new SocialConfigs();
    var activeNetworkTypes = Model.ActiveSocialNetworks;

    Layout = "~/Views/Shared/_Layout.cshtml";

    var allChannels = Model.Channels.Where(channel => activeNetworkTypes.Select(networkType => networkType.ToString().ToLower()).Contains(channel.Network.ToLower()));
    var channelIds = allChannels.Select(x => x.NetworkId);
    var loggedInUser = User?.Identity?.Name;
}


<div class="editor ms-auto pe-3" dir="rtl" style="max-width: 100%; width: 600px; background-color: white;">
    <div class="container pt-4 mt-4">
        <div class="form-items">

            <form id="form-share" method="post" action="send" class="p-4">
                <div class="d-flex justify-content-between align-items-center">
                    <h4>شبكات التواصل</h4>

                    <button type="submit" class="btn btn-primary d-flex align-items-center justify-content-center" style="width: 100px;color:white; max-width: 100%;     background: #4cb87a; border: none">مشاركة<i class="bi bi-share me-2"></i></button>
                </div>
                <hr />
                <div class="channel-list my-3 d-flex" style="column-gap: 20px; overflow-x: auto">

                    @{
                        var index = 0;

                    }
                    @foreach (var channel in allChannels)
                    {

                        <div class="channel d-flex flex-column align-items-center pb-4" style="width: fit-content">
                            <div class="d-flex flex-row-reverse">
                                <p class="text-capitalize mb-1">@channel.Network</p>
                                <i class="bi bi-@(channel.Network == "dailymotion" ? "play-circle" : channel.Network) social-icon ms-2"></i>
                            </div>
                            <img src="~/uploads/test.jpg" style="max-width: 90px; max-height= 90px:" />
                            <label for="@channel.Network">
                                @channel.OriginalName
                            </label>

                            <input type="radio" name="Data[0].ChannelId" value="@channel.Id" style="width: fit-content !important; height: auto" />
                            <input type="hidden" name="Channels" value="@allChannels" style="width: fit-content !important; height: auto" />

                        </div>


                    }
                </div>

                <div class="input-fields d-flex flex-column mt-4">

                    <div class="form-group mb-4">
                        <label class="mb-2 control-label">عنوان المنشور</label>
                        <br />
                        <input class="form-control" value="@post.Title" name="Data[0].Text" readonly type="text" />
                    </div>

                    <div class="form-group mb-4">
                        <label class="mb-2 control-label">عنوان قصير</label>
                        <br />
                        <input value="@post.ShortTitle" name="ShortTitle" readonly type="text" class="form-control" />
                    </div>

                    <div class="form-group mb-4">
                        <label class="mb-2 control-label">ملخص</label>
                        <br />
                        <input value="@post.Summary" name="Summary" readonly class="form-control" />
                    </div>

                    <div class="form-group mb-4">
                        <label class="mb-2 control-label">محتوى</label>
                        <br />
                        <input value="@post.Content" name="Content" readonly class="form-control" />
                    </div>


                    <div class="form-group mb-4">
                        @if (media != null)
                        {
                            <label for="MediaId" class="mb-2 control-label">ميديا </label>
                            <br />
                            <input type="image" name="Data[0].MediaId" src="@media.Path" alt="Submit" class="shareImage" value="@media.Id" class="form-control">
                        }
                    </div>
                </div>
                <input type="hidden" value="@post.Id" name="PostId" />

            </form>
            <script>
                document.getElementById('form-share').addEventListener('submit',
                    function (event) {

                        if ($("input[type=radio]:checked").length == 0) {
                            event.preventDefault();
                            alert("select at least one channel")
                        }

                        else {

                            var serviceURL = "/Social/Publish/Send" + event;
                            var shareForm = $(':input').serializeArray();
                            var imgSrc = $('.shareImage').attr('src');
                            var channelId = $("input[name='Channels[0]']:checked").val();

                            if (confirm("Are you sure you want to delete the selected users ?")) {
                                $.ajax({
                                    type: "POST",
                                    url: serviceURL,
                                    data: shareForm,
                                    success: function () {
                                        // location.href = "/Posts/List"
                                        //customized alert for success
                                        alert("success");
                                    },
                                    error: function (xhr, status, error) {
                                        var err = eval("(" + xhr.responseText + ")");
                                        alert(err.Message);
                                    },
                                })
                            }


                        }
                    });
            </script>



        </div>
    </div>
</div>


<style>


    input {
        text-align: start;
    }

    input {
        width: 510px !important;
        max-width: 100%;
        text-align: right;
        background-color: #e9ecef;
        color: #8a8a8a;
    }

    form input {
        padding-right: 10px !important;
        box-shadow: inherit !important;
        border-radius: 5px !important;
        border: 1px solid #ddd;
    }

    .shareImage {
        width: 400px !important;
        max-width: 100%;
        height: 100%;
        padding: 0 !important;
    }

    .social-icon::before {
        font-size: 20px;
    }

    .channel-list {
        -webkit-overflow-scrolling: touch;
    }

    /* ===== Scrollbar CSS ===== */
    /* Firefox */
    * {
        scrollbar-width: thin;
        scrollbar-color: #918b92 #ffffff;
    }

        /* Chrome, Edge, and Safari */
        *::-webkit-scrollbar {
            width: 5px;
            height: 15px;
        }

        *::-webkit-scrollbar-track {
            background: #ffffff;
        }

        *::-webkit-scrollbar-thumb {
            background-color: #918b92;
            border-radius: 10px;
            border: 4px solid #ffffff;
        }


    .form-container {
        row-gap: 7px;
    }

    .form-control:disabled, .form-control[readonly] {
        /*       background-color: #e9ecef;
                                opacity: 1; */

        padding: 10px;
        border-radius: 5px !important;
        border: 1px solid #ddd;
        box-shadow: inherit !important;
        color: #8a8a8a;
    }

    input.form-control:focus {
        background: #e9ecef;
        border: 1px solid #ddd !important;
    }
</style>

