@using FeedHiveAuth.Areas.Social.Models;
@using Microsoft.AspNetCore.Identity;
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@model FeedHiveAuth.Areas.Social.Models.ShareView

@{
    var post = Model.Post;
    var media = Model.Media;
    var socialConfigs = new SocialConfigs();
    var activeNetworkTypes = Model.ActiveSocialNetworks;

    Layout = "~/Views/Shared/_Layout.cshtml";

    var allChannels = Model.Channels.Where(channel => activeNetworkTypes.Select(networkType => networkType.ToString().ToLower()).Contains(channel.Network.ToLower()));
    var channelIds = allChannels.Select(x => x.NetworkId);
    var loggedInUser = User?.Identity?.Name;
}


<div class="editor" dir="auto" style="background: #ced4daa6; max-width: 510px">
    <div class="container pt-4 mt-4">
        <div class="form-items">

            @using (Html.BeginForm("Send", "Publish", new { area = "Social" }, FormMethod.Post))
            {
                <div>Channel List</div>

                <div class="channel-list my-3 align-items-center d-flex" style="column-gap: 20px; overflow-x: auto">

                    @{
                        var index = 0;
                    }
                    @foreach (var channel in allChannels)
                    {

                        <div class="channel d-flex flex-column align-items-center pb-4" style="width: fit-content">
                            <img src="~/uploads/test.jpg" style="max-width: 90px; max-height= 90px:" />
                            <label for="@channel.Network">
                                @channel.Network
                            </label>
                            <input type="checkbox" id="Channels[@index]" name="Channels[@index]" value="@channel.Network" style="width: fit-content; height: auto" />
                        </div>


                        <input type="hidden" name="Data[@index].ChannelId" id="Data[@index].ChannelId" value="@channel.Id" />
                    }
                </div>

                <div class="input-fields d-flex flex-column mt-4">
                    <lable formaction="PostId">Post Id</lable>
                    <input name="PostId" value="@post.Id" type="text" class="mb-3" id="PostId" />

                    <lable for="MediaId">Media Id</lable>
                    <input name="MediaId" value="@media.Id" type="text" class="mt-3" id="MediaId" />

                </div>

                <input type="submit" value="Submit" class="btn btn-primary mt-3" style="max-width: 200px;" />

            }

        </div>
    </div>
</div>


