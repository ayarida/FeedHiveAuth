@using FeedHiveAuth.Areas.Social.Models;
@using Microsoft.AspNetCore.Identity;
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@model FeedHiveAuth.Areas.Social.Models.ShareView

@{
    var post = Model.Post;
    var media = Model.Media;
    var socialConfigs = new SocialConfigs();
    var activeNetworkTypes = Model.ActiveSocialNetworks;

    Layout = "~/Views/Shared/_Layout.cshtml";

    var allChannels = Model.Channels.Where(channel => activeNetworkTypes.Select(networkType => networkType.ToString().ToLower()).Contains(channel.Network.ToLower()));
    var channelIds = allChannels.Select(x => x.NetworkId);
    var loggedInUser = User?.Identity?.Name;
}


<div class="editor ms-auto pe-3" dir="rtl" style="background: #8080800f; max-width: 100%; width: 600px">
    <div class="container pt-4 mt-4">
        <div class="form-items">

            <form id="form-share" method="post" action="send">
                <h4>شبكات التواصل</h4>
                <hr />

                <div class="channel-list my-3 d-flex" style="column-gap: 20px; overflow-x: auto">

                    @{
                        var index = 0;
                    }
                    @foreach (var channel in allChannels)
                    {

                        <div class="channel d-flex flex-column align-items-center pb-4" style="width: fit-content">
                            <div class="d-flex flex-row-reverse">
                                <p class="text-capitalize mb-1">@channel.Network</p>
                                <i class="bi bi-@(channel.Network == "dailymotion" ? "play-circle" : channel.Network) social-icon ms-2"></i>
                            </div>
                            <img src="~/uploads/test.jpg" style="max-width: 90px; max-height= 90px:" />
                            <label for="@channel.Network">
                                @channel.OriginalName
                            </label>

                            <input type="checkbox" id="Channels[@index]" name="Channels[@index]" value="@channel.Network" style="width: fit-content !important; height: auto" />

                        </div>

                        <input type="checkbox" name="Data[@index].ChannelId" id="Data[@index].ChannelId" style="opacity: 0 ; position: absolute" />
                        <script>

                            document.getElementById("Channels[0]").addEventListener("change", (e) => {

                                if (e.target.checked) {
                                    document.getElementById("Data[@index].ChannelId").checked = true

                                    document.getElementById("Data[@index].ChannelId").value = "@channel.Id"
                                } else {
                                    document.getElementById("Data[@index].ChannelId").value = ''
                                    document.getElementById("Data[@index].ChannelId").checked = false

                                }

                            })


                        </script>
                        index++;
                    }
                </div>

                <div class="input-fields d-flex flex-column mt-4">

                    <div class="form-group mb-4">
                        <label class="mb-2 control-label">عنوان المنشور</label>
                        <br />
                        <input class="form-control" value="@post.Title" name="Data[0].Text" readonly type="text" />
                    </div>

                    <div class="form-group mb-4">
                        <label class="mb-2 control-label">عنوان قصير</label>
                        <br />
                        <input value="@post.ShortTitle" name="ShortTitle" readonly type="text" />
                    </div>

                    <div class="form-group mb-4">
                        <label class="mb-2 control-label">ملخص</label>
                        <br />
                        <input value="@post.Summary" name="Summary" readonly />
                    </div>

                    <div class="form-group mb-4">
                        <label class="mb-2 control-label">محتوى</label>
                        <br />
                        <input value="@post.Content" name="Content" readonly />
                    </div>


                    <div class="form-group mb-4">
                        @if (media != null)
                        {
                            <label for="MediaId" class="mb-2 control-label">ميديا </label>
                            <br />
                            <input type="image" name="Data[0].MediaId" src="@media.Path" alt="Submit" class="shareImage" value="@media.Id">
                        }
                    </div>
                </div>
                <input type="hidden" value="@post.Id" name="PostId" />

                <button type="submit" class="btn btn-primary mt-3" style="max-width: 200px;color:white;">ارسل</button>

                </form>
                <script>
                document.getElementById('form-share').addEventListener('submit',
                    function (event) {

                        if ($("input[type=checkbox]:checked").length == 0) {
                            event.preventDefault();
                            alert("select at least one channel")
                        }

                        else {

                            var serviceURL = "/Social/Publish/Send" + event;
                            var shareForm = $(':input').serializeArray();
                            var imgSrc = $('.shareImage').attr('src');
                            shareForm.push(({ name: 'src', value: imgSrc }));

                            $.ajax({
                                type: "POST",
                                url: shareForm,
                                data: mediaId,
                                success: function (data) {
                                    window.location.reload()
                                },
                                error: function (data) {
                                    alert("error");
                                },
                            })
                        }
                    });
                </script>

           

        </div>
    </div>
</div>



